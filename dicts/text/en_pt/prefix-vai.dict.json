{"vain":{"id":"9445983a-1312-479c-bf9f-7894260f7c02","word":"vain","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"overly proud of one's appearance","word":"vaidoso"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"overly proud of one's appearance","word":"vão"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"based on very little substance","word":"vazio"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"pointless, futile","word":"vão"}],"pos":"adj","tags":null,"senses":[{"examples":[{"text":"Every writer is a narcissist. This does not mean that he is vain; it only means that he is hopelessly self-absorbed.","ref":"1959, Leo Rosten, The return of H*Y*M*A*N K*A*P*L*A*N:","type":"quotation","bold_text_offsets":[[60,64]],"id":"30e95220-4ec5-4e56-b24d-712e558912c9"}],"links":[["Overly","overly"],["proud","proud"],["especially","especially"],["concerning","concerning"],["appearance","appearance"],["high","high"],["opinion","opinion"],["accomplishment","accomplishment"],["slight","slight"],["reason","reason"]],"synonyms":[{"word":"conceited"},{"word":"flatulent"},{"word":"puffed up"},{"word":"inflated"},{"word":"airy","source":"Thesaurus:arrogant"},{"word":"arrogant","source":"Thesaurus:arrogant"},{"word":"chesty","source":"Thesaurus:arrogant","tags":["informal"]},{"word":"authoritarian","source":"Thesaurus:arrogant"},{"word":"biggity","source":"Thesaurus:arrogant"},{"word":"big-headed","source":"Thesaurus:arrogant","tags":["slang"]},{"word":"blustery","source":"Thesaurus:arrogant"},{"word":"boastful","source":"Thesaurus:arrogant"},{"word":"bombastic","source":"Thesaurus:arrogant"},{"word":"buggish","source":"Thesaurus:arrogant","tags":["dialectal","obsolete"]},{"word":"cocky","source":"Thesaurus:arrogant"},{"word":"conceited","source":"Thesaurus:arrogant"},{"word":"disdainful","source":"Thesaurus:arrogant"},{"word":"domineering","source":"Thesaurus:arrogant"},{"word":"egotistical","source":"Thesaurus:arrogant"},{"word":