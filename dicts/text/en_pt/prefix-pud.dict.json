"],"links":[["Entrails","entrails"]],"synonyms":[{"word":"bowels"},{"word":"guts"},{"word":"innards"}],"raw_glosses":["(slang) Entrails."],"glosses":["Entrails."],"tags":["countable","slang","uncountable"],"id":"5e38a206-abde-4e1d-9c77-4472c67ba866"},{"examples":[{"text":"Eat your pudding, slave, and hold your tongue.","ref":"1718, Matthew Prior, Merry Andrew:","type":"quotation","bold_text_offsets":[[9,16]],"id":"dbfc223d-c609-4b22-97e5-3cb679447526"}],"categories":["English terms with obsolete senses","English terms with quotations","Quotation templates to be cleaned"],"links":[["food","food"],["victuals","victuals"]],"synonyms":[{"word":"fodder"},{"word":"provisions"},{"word":"aliment","source":"Thesaurus:food"},{"word":"bait","source":"Thesaurus:food"},{"word":"belly-timber","source":"Thesaurus:food","tags":["archaic"]},{"word":"chow","source":"Thesaurus:food","tags":["slang"]},{"word":"comestibles","source":"Thesaurus:food","tags":["formal"]},{"word":"cuisine","source":"Thesaurus:food"},{"word":"eatables","source":"Thesaurus:food"},{"word":"eats","source":"Thesaurus:food","tags":["slang"]},{"word":"edibles","source":"Thesaurus:food"},{"word":"feed","source":"Thesaurus:food","raw_tags":["for domesticated animals"]},{"word":"fodder","source":"Thesaurus:food","raw_tags":["for domesticated animals"]},{"word":"foodstuffs","source":"Thesaurus:food"},{"word":"food","source":"Thesaurus:food"},{"word":"grub","source":"Thesaurus:food","tags":["slang"]},{"word":"kai","source":"Thesaurus:food","tags":["New-Zealand"]},{"word":"meals","source":"Thesaurus:food"},{"word":"meat","source":"Thesaurus:food","tags":["archaic"]},{"word":"munchable","source":"Thesaurus:food"},{"word":"nibbles","source":"Thesaurus:food"},{"word":"nosebag","source":"Thesaurus:food","tags":["informal"]},{"word":"nosh","source":"Thesaurus:food"},{"word":"nourishment","source":"Thesaurus:food"},{"word":"om nom nom","source":"Thesaurus:food","tags":["Internet"]},{"word":"provender","source":"Thesaurus:food