e47008178"},{"text":"One evening […] we were on a sudden, greatly astonished, by hearing a violent knocking on the outward Door of our rustic Cot.","ref":"1790, Jane Austen, “Love and Freindship”, in Juvenilia:","type":"quotation","bold_text_offsets":[[121,124]],"id":"5e7f2fb3-1bb6-4f9d-8163-9a17eb99b5c4"},{"text":"1898, Ethna Carbery, \"Roddy McCorley\" (poem).\nOh, see the fleet-foot hosts of men who speed with faces wan / From farmstead and from thresher's cot along the banks of Ban","type":"quotation","id":"9cdfed2c-af30-45a7-872e-ba2cb494641e"}],"categories":["English terms with archaic senses","English terms with quotations"],"raw_glosses":["(archaic) A cottage or small homestead."],"glosses":["A cottage or small homestead."],"tags":["archaic"],"id":"a6117cfa-012d-4148-9dc3-a647a1be817f"},{"synonyms":[{"word":"cote"}],"glosses":["A pen, coop, or similar shelter for small domestic animals, such as sheep or pigeons."],"id":"9229920c-c1aa-4ecf-9c36-8718b2089698"}],"related":[{"word":"coscet"},{"word":"cosset"},{"word":"cote"},{"word":"cotter"}],"synonyms":[]},"cotton wool":{"id":"ad7d9965-0bc9-4a75-84af-8621b7863501","word":"cotton wool","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"absorbent cotton","tags":["masculine"],"word":"algodão"}],"pos":"noun","tags":null,"senses":[{"categories":["American English"],"links":[["Raw","raw"],["fiber","fiber"],["cotton","cotton"],["processed","processed"]],"hypernyms":[{"word":"wool"}],"coordinate_terms":[{"word":"wool"}],"raw_glosses":["(US) Raw fibers of cotton before being processed."],"glosses":["Raw fibers of cotton before being processed."],"tags":["US","uncountable","usually"],"id":"77d9eeb6-398d-4b64-86ef-ee5cb840e4c3"},{"categories":["British English"],"links":[["Soft","soft"],["absorbent","absorbent"],["cotton","cotton"],["medical","medical"],["cosmetic","cosmetic"]],"hypernyms":[{"word":"wool"}],"coordinate_terms":[{"word":"cotton swab"}],"raw_glosses":["(UK) Soft, absorbent cotton for medica