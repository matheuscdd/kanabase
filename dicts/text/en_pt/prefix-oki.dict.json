osses":["The second-largest city on Okinawa Island, in Okinawa Prefecture, Japan."],"id":"1631800b-4cd9-443b-8eb5-c68eb57584eb"},{"categories":["English terms with historical senses","en:World War II"],"raw_glosses":["(historical, World War II) The Battle of Okinawa, which took place on the island of Okinawa in 1945."],"qualifier":"World War II","glosses":["The Battle of Okinawa, which took place on the island of Okinawa in 1945."],"tags":["historical"],"id":"47f2c65f-67a1-4f74-adfc-a696e4abc8ed"}],"related":[],"synonyms":[]},"okinawan":{"id":"c1dc4cfb-7b35-4ef6-9dc7-535a348e597a","word":"Okinawan","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"Okinawan language","tags":["masculine"],"word":"oquinauano"}],"pos":"name","tags":null,"senses":[{"links":[["Ryukyuan","Ryukyuan"],["Okinawa","Okinawa"]],"glosses":["A Ryukyuan language of Okinawa."],"id":"fc16ee3a-1927-465f-8722-3b8372ad9de0"}],"related":[{"word":"Wiktionary’s coverage of Okinawan terms"}],"synonyms":[]}}
