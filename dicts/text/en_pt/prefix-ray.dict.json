ces","physical-sciences","politics","publishing","science-fiction","tools","war","weaponry"],"categories":["English countable nouns","English entries with incorrect language header","English lemmas","English multiword terms","English nouns","English terms with quotations","Entries with translation boxes","Pages with 1 entry","Pages with entries","Terms with Catalan translations","Terms with Finnish translations","Terms with German translations","Terms with Icelandic translations","Terms with Korean translations","Terms with Portuguese translations","Terms with Spanish translations","Terms with Swedish translations","Terms with Welsh translations","en:Science fiction","en:Weapons"],"links":[["science fiction","science fiction"],["weaponry","weaponry"],["weapon","weapon"],["ray","ray#Noun"]],"synonyms":[{"word":"energy weapon"},{"word":"w:directed energy weapon"},{"word":"DEW"},{"word":";"},{"word":"death ray"},{"word":"heat-ray"}],"hypernyms":[{"word":"gun"},{"word":"weapon"}],"raw_glosses":["(science fiction, weaponry) A weapon that shoots harmful rays."],"glosses":["A weapon that shoots harmful rays."],"id":"f624f0d3-f460-4535-ba21-8ee0979f979d"}],"related":[{"word":"phaser"}],"synonyms":[]},"ray of light":{"id":"e334f25a-29b5-404e-8bb5-0c1a6a827b34","word":"ray of light","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"column of light","tags":["masculine"],"word":"raio de luz"}],"pos":"noun","tags":null,"senses":[{"topics":["natural-sciences","physical-sciences","physics"],"categories":["en:Physics"],"links":[["physics","physics"],["path","path"],["photon","photon"],["group","group"],["photon","photon"],["space","space"],["visible","visible"],["column","column"],["light","light"]],"synonyms":[{"word":"lightray"}],"raw_glosses":["(physics) A path that a photon or a group of photons takes through space, visible as a column of light."],"glosses":["A path that a photon or a group of photons takes through space, visible as a column of light."],"id":"eb413024-8771-4894-8993-a25a0544fa83"},{"examples":[{"text":"I think he was somewhat lost for a political position - a simple conservatism did not attract him - and I make the guess that Arnold had been a spar that he got hold of as he struggled to find a political position. I was certainly in that position, having been persuaded by Anderson, especially at the lunch-hour meetings of his Free-thought Society, of the bankruptcy of the Left. Arnold came to me as a most welcome ray of light.","ref":"2009, D.M. Armstrong, Quadrant, November 2009, No. 461 (Volume LIII, Number 11), Quadrant Magazine Limited, page 5","id":"f357324c-95c0-4626-b56d-e6d21219bc17"},{"text":"A ray of light amid all this nonsense was Gwyn Topham's piece in the Guardian, which was timely, measured, accurate and of appropriate tone. That this single report stood out so clearly as an exemplar is a scathing comment in itself on the volumes of drivel surrounding it.","ref":"2020 August 26, Nigel Harris, “Comment Special: Catastrophe at Carmont”, in Rail, page 4:","type":"quotation","bold_text_offsets":[[2,14]],"id":"022ddbeb-03b7-46bb-83e6-9af52b925acd"}],"categories":["English idioms","English terms with quotations"],"links":[["inspiring","inspiring"],["enlightening","enlightening"]],"raw_glosses":["(idiomatic) An inspiring or enlightening person or thing."],"glosses":["An inspiring or enlightening person or thing."],"tags":["idiomatic"],"id":"6373c51c-8a35-4b8c-899a-0241f3776b46"}],"related":[],"synonyms":[]}}
