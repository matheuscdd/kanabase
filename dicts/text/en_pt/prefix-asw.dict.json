{"as well as":{"id":"efd5ade6-e23d-49af-9edb-632d59c47f48","word":"as well as","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"in addition to","word":"assim como"}],"pos":"prep","tags":null,"senses":[{"examples":[{"text":"As well as the obvious financial benefits, the merger will allow us some breathing room with regards to R&D.","bold_text_offsets":[[0,10]],"type":"example","id":"ae66580f-3f3b-4ef7-ad15-1c5d62fd693d"}],"glosses":["In addition to; further to."],"categories":["English terms with usage examples"],"id":"fe4a0bc6-6cdf-48a8-a7f8-8d8633b77804"}],"related":[],"synonyms":[]},"as well":{"id":"e0be6991-d097-4473-9149-42c33c954c59","word":"as well","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"in addition, also","word":"também"}],"pos":"adv","tags":null,"senses":[{"examples":[{"text":"Wearing his hat and coat, he looked outside and decided he should take an umbrella as well.","bold_text_offsets":[[83,90]],"type":"example","id":"b267d053-146e-4eb9-acc8-5711917d3234"}],"categories":["English idioms","English terms with usage examples"],"links":[["In addition","in addition"],["also","also"]],"synonyms":[{"word":"additionally"},{"word":"too"},{"word":"in the bargain"}],"raw_glosses":["(idiomatic) In addition; also."],"glosses":["In addition; also."],"tags":["idiomatic","not-comparable"],"id":"530e9bb9-f692-4a74-aa3b-98cfcbad7a1f"},{"examples":[{"text":"They might as well walk as drive in this traffic.","bold_text_offsets":[[11,18]],"type":"example","id":"2a423125-e008-4064-8865-9b75a242fe39"},{"text":"There is no female mind. The brain is not an organ of sex. As well speak of the female liver.","ref":"1898, Charlotte Perkins Gilman, Women and Economics:","type":"quotation","bold_text_offsets":[[59,66]],"id":"52755df1-8dd8-4391-8d4a-706adcd7699e"}],"links":[["effect","effect"]],"categories":["English terms with quotations","English terms with usage examples","Quotation templates to be cleaned"],"glosses":["To the same effec