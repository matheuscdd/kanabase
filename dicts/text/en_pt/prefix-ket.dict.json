:[["organic chemistry","organic chemistry"],["homologous","homologous"],["organic","organic"],["molecules","molecules"],["functional group","functional group"],["oxygen","oxygen"],["atom","atom"],["carbon","carbon"]],"raw_glosses":["(organic chemistry) A homologous series of organic molecules whose functional group is an oxygen atom joined to a carbon atom—by a double bond—in a carbon-hydrogen based molecule."],"glosses":["A homologous series of organic molecules whose functional group is an oxygen atom joined to a carbon atom—by a double bond—in a carbon-hydrogen based molecule."],"id":"29801062-3420-4a56-909f-52a20e7c4710"}],"related":[{"word":"aldehyde"},{"word":"tautomerism"}],"synonyms":[]},"ketch":{"id":"dbefde3a-0330-4648-8d76-2733f0b520d8","word":"ketch","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"sailing vessel","tags":["masculine"],"word":"queche"}],"pos":"noun","tags":null,"senses":[{"examples":[{"text":"[…] to finish her new Habit or Appearance, and make her Change compleat, he ordered her Sails to be alter’d; and as she sailed before with a Half-Sprit, like a Yacht, she sailed now with square Sail and Mizen Mast, like a Ketch; so that, in a Word, she was a perfect Cheat […]","ref":"1720, Daniel Defoe, Captain Singleton, London: J. Brotherton et al, page 313:","type":"quotation","bold_text_offsets":[[222,227]],"id":"18495ec2-73ec-476e-b7df-47d5eabeff15"}],"links":[["fore-and-aft","fore-and-aft"],["sailing vessel","sailing vessel"],["main","mainmast"],["mizzen","mizzenmast"]],"categories":["English terms with quotations"],"glosses":["A fore-and-aft rigged sailing vessel with two masts, main and mizzen, the mizzen being stepped forward of the rudder post."],"id":"d1e431ff-9afa-401b-95fe-3ec1f7fc7845"}],"related":[{"word":"yawl"}],"synonyms":[]},"ketchup":{"id":"a9ee55dd-0c73-42d7-bd93-bd5a363d5383","word":"ketchup","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"tomato-vinegar based sauce","tags":["masculine"],"word":"ketchup"}],"pos":"noun","tags":null,"senses":[{"examples":[{"text":"tomato ketchup","bold_text_offsets":[[7,14]],"type":"example","id":"2d59988f-42c0-45ff-91cd-b57909410da2"},{"text":"This diner serves ketchup in red bottles, and mustard in yellow ones.","bold_text_offsets":[[18,25]],"type":"example","id":"8e2b0bf8-88db-4b77-ad57-2627cbc5c203"}],"categories":["American English","British English","Canadian English","English ellipses","English terms with usage examples","English uncountable nouns"],"links":[["tomato ketchup","tomato ketchup#English"],["tomato","tomato"],["vinegar","vinegar"],["sauce","sauce"],["spice","spice"],["onion","onion"],["garlic","garlic"],["sweetener","sweetener"]],"synonyms":[{"word":"tomato catsup"}],"hypernyms":[{"word":"tomato sauce"},{"word":"red ketchup"},{"word":"red catsup"}],"raw_glosses":["(uncountable, chiefly US, Canada, UK) Ellipsis of tomato ketchup (“a tomato-vinegar-based sauce, sometimes containing spices, onion or garlic, and (especially in the US) sweeteners”)."],"glosses":["Ellipsis of tomato ketchup (“a tomato-vinegar-based sauce, sometimes containing spices, onion or garlic, and (especially in the US) sweeteners”)."],"tags":["Canada","UK","US","abbreviation","alt-of","ellipsis","uncountable"],"alt_of":[{"word":"tomato ketchup","extra":"(“a tomato-vinegar-based sauce, sometimes containing spices, onion or garlic, and (especially in the US) sweeteners”)"}],"id":"5de37136-95d3-4d6f-8f59-e768df8ee065"},{"examples":[{"text":"The bottles, however, were port bottles, but contained mushroom ketchup; […]","ref":"1883, Cassell's Dictionary of Cookery, page lxxxiii:","type":"quotation","bold_text_offsets":[[64,71]],"id":"e16c6326-f7a7-4283-b631-1281c7aff42e"},{"text":"To accompany meat, we prepare fruit ketchups and rhubarb chutney.","ref":"2003, Inns and Bed and Breakfasts in Quebec 2003, Ulysses Travel Guides, page 46:","type":"quotation","bold_text_offsets":[[36,44]],"id":"ff7837c9-68d9-4ec5-b0a6-f5d27878a7f0"}],"categories":["English countable nouns","English terms with quotations","English terms with rare senses"],"raw_glosses":["(countable, now rare) Such a sauce more generally (not necessarily based on tomatoes, but with mushrooms, fish, etc.). This is the older meaning."],"glosses":["Such a sauce more generally (not necessarily based on tomatoes, but with mushrooms, fish, etc.). This is the older meaning."],"tags":["archaic","countable"],"id":"697cef2a-8ead-42a3-a059-a19e34d11dc8"}],"related":[],"synonyms":[]},"kettledrum":{"id":"a91e5223-22a4-45a2-a7cf-a8e247774100","word":"kettledrum","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"percussion instrument","tags":["masculine"],"word":"tímpano"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"percussion instrument","tags":["masculine"],"word":"timbale"}],"pos":"noun","tags":null,"senses":[{"topics":["entertainment","lifestyle","music"],"categories":["en:Musical instruments"],"links":[["music","music"],["percussion instrument","percussion instrument"],["drumhead","drumhead"],["hemispherical","hemispherical"]],"synonyms":[{"word":"timpanum"}],"raw_glosses":["(music) A large percussion instrument with a drumhead that is stretched over a hemispherical metal bowl."],"glosses":["A large percussion instrument with a drumhead that is stretched over a hemispherical metal bowl."],"id":"23d5223c-5223-41c4-b014-1303a854c04e"},{"categories":["English dated terms"],"links":[["snack","snack"]],"raw_glosses":["(dated) An informal social party at which a light snack is offered, held in the afternoon or early evening."],"glosses":["An informal social party at which a light snack is offered, held in the afternoon or early evening."],"tags":["dated"],"id":"025e84b5-635f-4106-9de4-0ca5485f75d0"}],"related":[],"synonyms":[]},"ketamine":{"id":"6d7cee09-b2f2-4b8e-b25f-c27f1bbf3308","word":"ketamine","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"pain-killing drug","tags":["feminine"],"word":"cetamina"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"pain-killing drug","tags":["feminine"],"word":"quetamina"}],"pos":"noun","tags":null,"senses":[{"examples":[{"text":"He was riding high that night, with a brick of Wage's ketamine on its way to Yokohama and the money already in his pocket.","ref":"1984, William Gibson, Neuromancer (Sprawl; book 1), New York, N.Y.: Ace Books, →ISBN, page 8:","type":"quotation","bold_text_offsets":[[54,62]],"id":"a789e808-80ae-4358-8e80-8a6d03325846"},{"text":"The chatbot instructed him to give up sleeping pills and an anti-anxiety medication, and to increase his intake of ketamine, a dissociative anesthetic, which ChatGPT described as a “temporary pattern liberator.”","ref":"2025 June 13, Kashmir Hill, “They Asked ChatGPT Questions. The Answers Sent Them Spiraling.”, in The New York Times, →ISSN:","type":"quotation","bold_text_offsets":[[115,123]],"id":"72ea721c-5101-48af-9ecd-36886b9885ce"},{"text":"Urology departments across the UK could be close to breaking point after ketamine-related hospital admissions have \"skyrocketed\" in recent years, experts have warned. The class-B dissociative drug used for pain relief and sedation is increasingly used recreationally in the UK. […] a consultant urological surgeon in Sheffield, said admissions tied to ketamine abuse had \"skyrocketed\" in the past few years, and that not enough users understood the effect that consistently taking the drug would have on their bodies. \"Ketamine is a unique drug because it seems like there are no side-effects, but it's more complicated than that,\" he said. \"It slowly impacts the bladder and the liver, and then the urinary tract. It takes a couple of years to begin to notice these effects, but once you start noticing them they're pretty irreversible.\"","ref":"2025 December 31, Raphael Boyd, “Cases of ketamine abuse are surging, say urologists”, in The Guardian, page 16:","type":"quotation","bold_text_offsets":[[73,81],[352,360],[519,527]],"id":"13821469-e965-40ea-b9d3-61b4dc740c64"}],"topics":["medicine","pharmacology","sciences"],"wikidata":["Q243547"],"senseid":["en:Q243547"],"categories":["English blends","English countable nouns","English entries with incorrect language header","English lemmas","English nouns","English terms suffixed with -amine","English terms with quotations","English uncountable nouns","Entries with translation boxes","Mandarin terms with non-redundant manual transliterations","Mandarin terms with redundant transliterations","Pages with 2 entries","Pages with entries","Terms with Dutch translations","Terms with Finnish translations","Terms with German translations","Terms with Greek translations","Terms with Irish translations","Terms with Mandarin translations","Terms with Polish translations","Terms with Portuguese translations","Terms with Romanian translations","Terms with Russian translations","Terms with Spanish translations","Terms with Swedish translations","Terms with Turkish translations","Terms with Welsh translations","en:Pharmaceutical drugs","en:Recreational drugs"],"links":[["pharmacology","pharmacology"],["synthetic","synthetic"],["compound","compound"],["dissociative","dissociative"],["anesthetic","anesthetic"],["analgesic","analgesic"],["recreationally","recreationally"],["hallucinogen","hallucinogen"]],"synonyms":[{"word":"Special K"},{"word":"vitamin K"},{"word":"horse tranquilizer"}],"raw_glosses":["(pharmacology) A synthetic compound used as a dissociative anesthetic and analgesic drug and also recreationally as a hallucinogen."],"glosses":["A synthetic compound used as a dissociative anesthetic and analgesic drug and also recreationally as a hallucinogen."],"tags":["countable","uncountable"],"id":"3b79e755-aeab-40d0-a53e-b079337b51d8"}],"related":[],"synonyms":[]},"ketogenic":{"id":"3b32fa03-faf6-4326-af17-630d19f60bd0","word":"ketogenic","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"relating to ketogenesis","tags":["Brazil"],"word":"ceto