],"id":"63dc5c84-4082-495e-8ff8-96a1cf030548"}],"related":[],"synonyms":[]},"dynamo":{"id":"65f64dd3-6d59-4007-a42b-93b4d18cd02c","word":"dynamo","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"dynamo-electric machine","tags":["masculine"],"word":"dínamo"}],"pos":"noun","tags":null,"senses":[{"examples":[{"text":"\"As usual, it isn't telling the truth about it or you. But your body is. I can feel its vitality like the pulse of a dynamo.\"","ref":"1950, Norman Lindsay, Dust or Polish?, Sydney: Angus and Robertson, page 176:","type":"quotation","bold_text_offsets":[[117,123]],"id":"14c80f72-74bf-4179-a900-e9c8001406f2"}],"topics":["electrical-engineering","electromagnetism","engineering","natural-sciences","physical-sciences","physics"],"categories":["English terms with quotations","en:Electromagnetism"],"links":[["electromagnetism","electromagnetism"],["electricity","electricity"],["generator","generator"],["dynamo-electric machine","dynamo-electric machine"]],"raw_glosses":["(electromagnetism) An electricity generator; a dynamo-electric machine."],"glosses":["An electricity generator; a dynamo-electric machine."],"id":"650c26a8-44a4-49f4-b837-86a5679b1fe9"},{"topics":["astrophysics"],"categories":["en:Astrophysics"],"links":[["astrophysics","astrophysics"],["celestial body","celestial body"],["magnetic field","magnetic field"]],"raw_glosses":["(astrophysics) The mechanism by which a celestial body, such as the Earth or a star, generates a magnetic field."],"glosses":["The mechanism by which a celestial body, such as the Earth or a star, generates a magnetic field."],"id":"eb6d5d8c-26cd-4635-992f-98db7f348c19"},{"examples":[{"text":"That new Vice President of Marketing is a real dynamo; sales have already gone up this quarter.","bold_text_offsets":[[47,53]],"type":"example","id":"aa844a68-939c-45e6-b354-a7586bc654fa"}],"links":[["energetic","energetic"],["person","person"]],"raw_glosses":["(figuratively) An energetic person."],"glosses":["An energetic person."],"categories":["English terms with usage examples"],"tags":["figuratively"],"id":"245d8ef2-4ec0-49b0-b5c2-0eea0321448c"}],"related":[{"word":"dynamics"}],"synonyms":[]},"dynast":{"id":"f8ed05d1-dc18-4d31-8863-baf63c66c367","word":"dynast","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"a ruler or governor, especially a hereditary ruler or someone who founded or is part of a dynasty","tags":["masculine"],"word":"dinasta"}],"pos":"noun","tags":null,"senses":[{"examples":[{"text":"Now the dynasts who rule each country are cementing political ties.","ref":"2011 July 30, “Embraceable you”, in The Economist:","type":"quotation","bold_text_offsets":[[8,15]],"id":"ab4a0e76-2142-4a21-8d68-a5b2724f3d84"}],"links":[["ruler","ruler"],["governor","governor"],["hereditary","hereditary"],["dynasty","dynasty"]],"categories":["English countable nouns","English entries with incorrect language header","English lemmas","English nouns","English terms borrowed from Late Latin","English terms derived from Ancient Greek","English terms derived from Late Latin","English terms derived from Proto-Indo-European","English terms derived from the Proto-Indo-European root *dewh₂-","English terms with quotations","Entries with translation boxes","Pages with 1 entry","Pages with entries","Terms with French translations","Terms with German translations","Terms with Italian translations","Terms with Mandarin translations","Terms with Norwegian Bokmål translations","Terms with Norwegian Nynorsk translations","Terms with Portuguese translations","Terms with Spanish translations","Terms with Tagalog translations","en:People"],"glosses":["A ruler or governor, especially a hereditary ruler or someone who founded or is part of a dynasty."],"id":"fbc2e21e-5e2b-4daa-8be5-b139923330b8"}],"related":[{"word":"dynastic"},{"word":"dynasty"}],"synonyms":[]},"dynasty":{"id":"c04e830c-5518-4241-b05f-ac0927ed5a45","word":"dynasty","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"a series of rulers or dynasts from one family","tags":["feminine"],"word":"dinastia"}],"pos":"noun","tags":null,"senses":[{"examples":[{"text":"Habsburg dynasty; Ottoman dynasty","bold_text_offsets":[[9,16],[26,33]],"type":"example","id":"a2220e3a-3f9c-42d2-b6ac-6fbc00bb6c79"},{"text":"A dynasty is nothing but the successful orchestration of treachery.","ref":"2023, Stewart Stafford, A Wager After Midnight","type":"quotation","id":"0d2f479a-9d1a-4e21-8b18-7b31afe1cc36"},{"text":"Tonight, against all odds, we have grasped it. The future is in our hands. My friends, we have toppled a political dynasty.","ref":"2025 November 5, Zohran Mamdani, “The Full Transcript of Zohran Mamdani’s Victory Speech”, in The New York Times, New York, N.Y.: The New York Times Company, →ISSN, →OCLC:","type":"quotation","bold_text_offsets":[[115,122]],"id":"39be700e-22d3-44fa-9e53-6c07b6ac853a"}],"links":[["ruler","ruler"],["dynast","dynast"],["family","family"]],"synonyms":[{"word":"house"},{"word":"succession"}],"categories":["English terms with quotations","English terms with usage examples"],"glosses":["A series of rulers or dynasts from one family."],"id":"14c78403-d315-4f70-a5c7-e3ff5160da84"},{"examples":[{"text":"To the loyal and to the blood-lovers, in the good families and in the fiery dynasties, life is family and family is life. It is the same people who give advice and their vices to live well who turn out to be the ones who give resource and reason to live long.","ref":"2016, Criss Jami, Healology","type":"quotation","id":"fe18a0aa-e5e7-4bb8-b347-8748093b463c"}],"links":[["family","family"],["ancestor","ancestor"],["descendant","descendant"]],"synonyms":[{"word":"clan"},{"word":"house"},{"word":"lineage"}],"categories":["English terms with quotations"],"glosses":["A family considered over time, with its ancestors and descendants"],"id":"90cd2abd-4881-4385-aad4-7572eb1864b1"},{"examples":[{"text":"During the Ming dynasty, China was ruled by the Zhu family.","bold_text_offsets":[[16,23]],"type":"example","id":"681f2330-bde6-4e67-b8a8-451166847170"}],"links":[["polity","polity"],["historical","historical"],["era","era"]],"raw_glosses":["(East Asian history) The polity or historical era under the rule of a certain dynasty."],"qualifier":"East Asian history","glosses":["The polity or historical era under the rule of a certain dynasty."],"categories":["English terms with usage examples"],"id":"b1256bd6-8f4c-4967-8dc7-3472a5d54a60"},{"topics":["hobbies","lifestyle","sports"],"categories":["en:Sports"],"links":[["sports","sports"],["team","team"],["organization","organization"],["extended","extended"],["period","period"],["success","success"]],"raw_glosses":["(sports) A team or organization which has an extended period of success or dominant performance."],"glosses":["A team or organization which has an extended period of success or dominant performance."],"id":"b0a13c20-9b44-4ad0-a37e-2854285da0ad"}],"related":[],"synonyms":[]},"dynamically":{"id":"3f577e7c-47b7-43c6-b020-65bf278ec52e","word":"dynamically","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"of a dynamic nature","word":"dinamicamente"}],"pos":"adv","tags":null,"senses":[{"examples":[{"text":"An averager of the sort described earlier would operate such that, as the frequency of sinusoidal variation of ITD was increased, more and more samples of the dynamically varying ITD would fall within the averaging window and the effective ITD would tend toward their mean of zero.","ref":"2014, Robert Gilkey, Timothy R. Anderson, Binaural and Spatial Hearing in Real and Virtual Environments:","type":"quotation","bold_text_offsets":[[159,170]],"id":"56e645b8-c447-4cbe-ae17-f1c5e07af2de"}],"links":[["dynamic","dynamic"]],"categories":["English adverbs","English entries referencing etymons with mismatched IDs","English entries with etymology texts","English entries with etymology trees","English entries with incorrect language header","English lemmas","English terms derived from the Proto-Indo-European root *dewh₂-","English terms derived from the Proto-Indo-European root *h₂el- (grow)","English terms derived from the Proto-Indo-European root *leyg- (like)","English terms suffixed with -ally","English terms with quotations","Entries with translation boxes","Pages using etymon with no ID","Pages with 1 entry","Pages with entries","Pages with etymology trees","Quotation templates to be cleaned","Terms with Catalan translations","Terms with Danish translations","Terms with French translations","Terms with Galician translations","Terms with Hungarian translations","Terms with Italian translations","Terms with Norwegian Bokmål translations","Terms with Polish translations","Terms with Portuguese translations","Terms with Spanish translations","Terms with Ukrainian translations"],"glosses":["In a dynamic way: variably, changingly."],"id":"fd168ec6-ebba-4c85-b230-6d687af94c5a"}],"related":[],"synonyms":[]},"dynamite":{"id":"4fac1a97-5595-484b-b5e0-7bde91f36d19","word":"dynamite","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"to blow up with dynamite or other high explosive","word":"dinamitar"}],"pos":"verb","tags":null,"senses":[{"examples":[{"text":"Gradually the construction gangs cut and dynamited their way through some of the most difficult country in the world.","ref":"1954 February, Trevor Holloway, “Canada's Transcontinental Railway”, in Railway Magazine, page 128:","type":"quotation","bold_text_offsets":[[41,50]],"id":"fd09c0da-bcda-4fc9-b308-4aad34b0c2b1"},{"text":"[...] on Sunday, August 23, the L.N.W.R. tunnel was closed to enable the old brickwork to be dynamited away, traffic being diverted meanwhile through the M.R. tunnel.","ref":"1960 February, R. C. Riley, “The London-Birmingham services - Past, Present and Future”, in Trains Illustrated, page 101:","type":"quotation","bold_text_offsets":[[93,102]],"id":"52f77b25-a083-4b1a-a0c1-225878ae3ab6"}],"links":[["blow up","blow up"],["dynamite","#Noun"],["high explosive","high explosive"]],"categories":["English terms with quotations"],"glosses":["To blow up with dynamite or other high explosive."],"id":"de325296-e0aa-4d5a-a858-998eb0cf46ad"},{"examples":[{"text":"Even the successful battle in the last century to overturn the court’s infamous Plessy vs. Ferguson “separate but equal” doctrine wasn’t a frontal assault that dynamited precedent.","ref":"2021 July 29, Harry Litman, “Column: Mississippi’s abortion brief dynamites standing law and ‘super duper’ precedents”, in The Los Angeles Times:","type":"quotation","bold_text_offsets":[[160,169]],"id":"9980f8e4-b61d-4a0b-89a3-c487862c4854"}],"links":[["dismantle","dismantle"],["destroy","destroy"]],"categories":["English terms with quotations"],"raw_glosses":["(figuratively) To dismantle or destroy."],"glosses":["To dismantle or destroy."],"tags":["figuratively"],"id":"f2bff02a-b6d0-4eae-8825-721a2f41b921"},{"examples":[{"text":"dynamite the brakes","bold_text_offsets":[[0,8]],"type":"example","id":"0d8a04da-085c-45f3-84c3-6c9a27792155"},{"text":"Juan dynamited the brakes and the car skidded to a halt.","ref":"2009, Claude M. Pearson, Portia Rising, page 50:","type":"quotation","bold_text_offsets":[[5,14]],"id":"837a01e7-d8cf-40ae-a8b0-87a994d363f5"},{"text":"The 1977 Pontiacs had a tendency of dying if you were at high speed and dynamited the brakes.","ref":"2014, Mike Davis, Hunting Men: The Career of an Oregon State Police Detective, page 6:","type":"quotation","bold_text_offsets":[[72,81]],"id":"4f898a80-0263-4c5f-8ae3-14a426dccf55"},{"text":"At the critical moment I'd learned from countless action flicks I dynamited the brakes and felt the impact of the sedan against my rear bumper.","ref":"2018, Laird Barron, Blood Standard:","type":"quotation","bold_text_offsets":[[66,75]],"id":"05593d1d-e4fc-449b-8361-dff0db5073f6"}],"categories":["English terms with quotations","English terms with usage examples","English transitive verbs"],"raw_glosses":["(transitive, of br