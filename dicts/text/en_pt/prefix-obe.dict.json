type":"example","id":"aea1d4f6-e8ff-48fe-9861-833268b26408"},{"text":"February 24, 1823, Thomas Jefferson, letter to Mr. Edward Everett\nResistance to tyrants is obedience to God.","id":"b2c25e57-584e-4f7b-86af-b40488d67973"},{"text":"Cautioning Nobs to silence, and he had learned many lessons in the value of obedience since we had entered Caspak, I slunk forward, taking advantage of whatever cover I could find...","ref":"1918 September–November, Edgar Rice Burroughs, “The Land That Time Forgot”, in The Blue Book Magazine, Chicago, Ill.: Story-press Corp., →OCLC; republished as chapter VIII, in Hugo Gernsback, editor, Amazing Stories, (please specify |part=I to III), New York, N.Y.: Experimenter Publishing, 1927, →OCLC:","type":"quotation","bold_text_offsets":[[76,85]],"id":"65b66a0a-5c45-4cf7-8774-c9d27dd0ccc1"}],"links":[["obedient","obedient"]],"glosses":["The quality of being obedient."],"categories":["English terms with quotations","English terms with usage examples"],"tags":["countable","uncountable"],"id":"3e6cf9b2-0f7d-40a7-9216-64fe830d98c5"},{"glosses":["The collective body of persons subject to any particular authority."],"tags":["countable","uncountable"],"id":"29b316db-eef8-447d-8908-0cf9048a2938"},{"glosses":["A written instruction from the superior of an order to those under him."],"tags":["countable","uncountable"],"id":"2ca542c3-7be4-4721-b6c9-ee5d471609e5"},{"glosses":["Any official position under an abbot's jurisdiction."],"tags":["countable","uncountable"],"id":"3af9a2dd-c08a-46d5-bd4c-cd92aca51694"}],"related":[{"word":"obedient"},{"word":"obeisance"},{"word":"obey"}],"synonyms":[{"word":"submission"},{"tags":["nonce-word"],"word":"hearsomeness"}]},"obedient":{"id":"3248b5dc-1339-4f62-819a-808e98d93dc8","word":"obedient","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"willing to comply with commands","word":"obediente"}],"pos":"adj","tags":null,"senses":[{"examples":[{"text":"Jessica was so intensely obedient of her parents that her brother sometimes thought she was a robot.","bold_text_offsets":[[25,33]],"type":"example","id":"30ad6f0e-ef42-413d-ac8e-a1a2a7ad3842"}],"links":[["Willing","willing"],["comply","comply#Verb"],["command","command"],["order","order"],["instruction","instruction"],["authority","authority"],["biddable","biddable"]],"glosses":["Willing to comply with the commands, orders, or instructions of those in authority; biddable."],"categories":["English terms with usage examples"],"id":"2fcaf8f8-f92f-41b1-8505-e6c42fcf6519"}],"related":[{"word":"obedience"},{"word":"obey"},{"word":"at one's beck and call","source":"Thesaurus:obedient"},{"word":"wrap around one's little finger","source":"Thesaurus:obedient"},{"word":"obdt","source":"Thesaurus:obedient","tags":["archaic"]},{"word":"obedt","source":"Thesaurus:obedient","tags":["obsolete"]},{"word":"domable","source":"Thesaurus:obedient","tags":["obsolete","rare"]},{"word":"domesticable","source":"Thesaurus:obedient"},{"word":"domesticatable","source":"Thesaurus:obedient"},{"word":"tameable","source":"Thesaurus:obedient"},{"word":"conformant","source":"Thesaurus:obedient"},{"word":"flattery","source":"Thesaurus:obedient"},{"word":"humble","source":"Thesaurus:obedient"},{"word":"sycophant","source":"Thesaurus:obedient"}],"synonyms":[{"word":"hearsome"},{"word":"dutiful"},{"word":"compliant"},{"word":"bowsome","source":"Thesaurus:obedient","tags":["archaic"]},{"word":"buxom","source":"Thesaurus:obedient","tags":["obsolete"]},{"word":"morigerous","source":"Thesaurus:obedient","tags":["obsolete"]},{"word":"obedible","source":"Thesaurus:obedient","tags":["obsolete"]},{"word":"obedient","source":"Thesaurus:obedient"},{"word":"obsequent","source":"Thesaurus:obedient","tags":["obsolete"]},{"word":"obsequious","source":"Thesaurus:obedient","tags":["archaic"]},{"word":"tall","source":"Thesaurus:obedient","tags":["obsolete"]},{"word":"toward","source":"Thesaurus:obedient"}]},"obelisk":{"id":"527b65f2-4609-4f6d-b22a-98868762ffab","word"