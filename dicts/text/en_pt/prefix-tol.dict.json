ations":[{"date":"from 1531","references":[]}],"links":[["tolerated","tolerate"],["countenanced","countenance"],["permissible","permissible"],["allowable","allowable"]],"synonyms":[{"word":"acceptable"},{"word":"admissible"},{"word":"sufferable"},{"word":"abideable","source":"Thesaurus:permissible"},{"word":"acceptable","source":"Thesaurus:permissible"},{"word":"admissible","source":"Thesaurus:permissible"},{"word":"allowable","source":"Thesaurus:permissible"},{"word":"permissible","source":"Thesaurus:permissible"},{"word":"sufferable","source":"Thesaurus:permissible"},{"word":"supportable","source":"Thesaurus:permissible"},{"word":"tolerable","source":"Thesaurus:permissible"}],"antonyms":[{"word":"intolerable"},{"word":"unacceptable"}],"glosses":["Such as to be tolerated or countenanced; permissible; allowable."],"id":"f70a5eb5-4208-41ff-bedd-43acb927ba3d"},{"links":[["fair","fair"]],"synonyms":[{"word":"all right"},{"word":"fine"},{"word":"OK"}],"antonyms":[{"word":"healthy as a horse"},{"word":"poorly"}],"glosses":["In fair health; passably well."],"id":"f68f7f48-fc62-4a0d-8c16-144d5f6efd90"}],"related":[{"word":"tolerance"},{"word":"tolerant"},{"word":"tolerate"},{"word":"lasting","source":"Thesaurus:tolerable"}],"synonyms":[{"word":"abideable","source":"Thesaurus:tolerable"},{"word":"bearable","source":"Thesaurus:tolerable"},{"word":"endurable","source":"Thesaurus:tolerable"},{"word":"livable","source":"Thesaurus:tolerable"},{"word":"portable","source":"Thesaurus:tolerable","tags":["obsolete"]},{"word":"sufferable","source":"Thesaurus:tolerable"},{"word":"supportable","source":"Thesaurus:tolerable"},{"word":"survivable","source":"Thesaurus:tolerable"},{"word":"tolerable","source":"Thesaurus:tolerable"},{"word":"withstandable","source":"Thesaurus:tolerable"}]},"tolerance":{"id":"2bbc4c86-8681-46d7-975b-f810e1274ff4","word":"tolerance","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"ability or practice of tolerating","tags":["feminine"],"word"