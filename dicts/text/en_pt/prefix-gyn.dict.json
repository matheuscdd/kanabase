lang":"Portuguese","code":"pt","lang_code":"pt","sense":"pertaining to women","word":"gino-"}],"pos":"prefix","tags":null,"senses":[{"links":[["women","women"]],"glosses":["Of or pertaining to women."],"tags":["morpheme"],"id":"ff579871-17bb-4be6-8594-33308a56d9ab"},{"links":[["female","female"],["reproductive system","reproductive system"]],"antonyms":[{"word":"andro-"}],"glosses":["Of or pertaining to the female reproductive system."],"tags":["morpheme"],"id":"9fad1e0d-bb99-4fb6-8a91-644c817c10d0"}],"related":[],"synonyms":[{"word":"gynaeco-"},{"word":"gynæco-"},{"word":"gyneco-"}]},"gynarchy":{"id":"4b0462ec-7eee-4a7d-8944-4caf576e14b1","word":"gynarchy","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"government by a woman or women","tags":["feminine"],"word":"ginarquia"}],"pos":"noun","tags":null,"senses":[{"examples":[{"text":"But I have always ſome hopes of a change under a Gunarchy ; where whim and humour commonly prevail, reaſon very ſeldom, and then only by a lucky miſtake.","ref":"1759 February 2, Philip Stanhope, 4th Earl of Chesterfield, Letters Written by the Late Right Honourable Philip Dormer Stanhope, Earl of Chesterfield, to His Son, Philip Stanhope, Esq.; Late Envoy Extraordinary to the Court of Dresden, volume II, Dublin: Eugenia Stanhope, published 1774, page 447:","type":"quotation","bold_text_offsets":[[49,57]],"id":"7cd86c56-108f-4308-93f8-b7ed9d49efde"},{"text":"Though no ways anti-matrimonial, this faithful servitor was not particularly desirous of serving under a gynarchy, while on the other hand he was not destitute of feelings of gratitude for services rendered him by Miss Bud, which he endeavored to maintain consistently with fidelity to his master.","ref":"1839, MGM, “The Bachelor Beset”, in Southern Literary Messenger, volume V, Richmond: Thos. W. White, page 753:","type":"quotation","bold_text_offsets":[[105,114]],"id":"8e336606-262f-4342-8ace-d0f4e8ea0baa"}],"topics":["government","politics"],"categories":["Englis