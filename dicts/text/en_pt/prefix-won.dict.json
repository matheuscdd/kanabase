edible","source":"Thesaurus:awesome"},{"word":"inspiring","source":"Thesaurus:awesome"},{"word":"goshwow","source":"Thesaurus:awesome","tags":["dated","slang"]},{"word":"glorious","source":"Thesaurus:awesome"},{"word":"gnarly","source":"Thesaurus:awesome","tags":["dated","slang"]},{"word":"goated","source":"Thesaurus:awesome","tags":["Internet"]},{"word":"grand","source":"Thesaurus:awesome"},{"word":"grandiose","source":"Thesaurus:awesome"},{"word":"great","source":"Thesaurus:awesome"},{"word":"groovy","source":"Thesaurus:awesome","tags":["dated","slang"]},{"word":"magnificent","source":"Thesaurus:awesome"},{"word":"major","source":"Thesaurus:awesome"},{"word":"majestic","source":"Thesaurus:awesome"},{"word":"marvellous","source":"Thesaurus:awesome"},{"word":"mystifying","source":"Thesaurus:awesome"},{"word":"mythic","source":"Thesaurus:awesome"},{"word":"neat","source":"Thesaurus:awesome"},{"word":"lit","source":"Thesaurus:awesome","tags":["slang"]},{"word":"outstanding","source":"Thesaurus:awesome"},{"word":"phenomenal","source":"Thesaurus:awesome"},{"word":"powerful","source":"Thesaurus:awesome"},{"word":"rad","source":"Thesaurus:awesome","tags":["slang"]},{"word":"righteous","source":"Thesaurus:awesome","tags":["US","slang"]},{"word":"selcouth","source":"Thesaurus:awesome"},{"word":"splendent","source":"Thesaurus:awesome","tags":["archaic"]},{"word":"stupendous","source":"Thesaurus:awesome"},{"word":"stupefying","source":"Thesaurus:awesome"},{"word":"sublime","source":"Thesaurus:awesome"},{"word":"surpassing","source":"Thesaurus:awesome"},{"word":"terrific","source":"Thesaurus:awesome"},{"word":"tight","source":"Thesaurus:awesome","tags":["slang"]},{"word":"unbelievable","source":"Thesaurus:awesome"},{"word":"unreal","source":"Thesaurus:awesome"},{"word":"wicked","source":"Thesaurus:awesome","tags":["dated","slang"]},{"word":"wonderful","source":"Thesaurus:awesome"},{"word":"wondrous","source":"Thesaurus:awesome"}],"glosses":["Wonderful; amazing, inspiring awe; marvelous."],"categories":["English terms with quotations","English terms with usage examples"],"id":"2dd73ec7-7be4-4b3b-9fab-174f5ae116a3"}],"related":[],"synonyms":[]},"wonderland":{"id":"9604336a-f80c-44a2-a716-e95b1f3edf2c","word":"wonderland","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"Imaginary or real place full of wonder or marvels","tags":["masculine"],"word":"país das maravilhas"}],"pos":"noun","tags":null,"senses":[{"examples":[{"text":"Where other trav'lers, fraught with terror, roam, Lo! Bruce in Wonder-land is quite at home.","ref":"1790 J. Wolcot Compl. Epist. to Bruce 332, in Wks. (1812) II. 368","type":"quotation","id":"4aea2722-5296-410d-a828-503b91c698f7"},{"text":"It's a geological wonderland, with great exposures of colorful and varied sedimentary rocks.","ref":"2012, Chinle Miller, In Mesozoic Lands: The Mesozoic Geology of Arches and Canyonlands National Parks, Kindle edition:","type":"quotation","bold_text_offsets":[[18,28]],"id":"548a9a83-b9a8-4b5d-b620-d0194d282233"}],"links":[["wonder","wonder"],["marvel","marvel"]],"categories":["English terms with quotations"],"glosses":["A place full of wonder or marvels."],"id":"f28b8f62-d894-476e-bf37-cc7aeb143405"},{"examples":[{"text":"Typically only used in tulpamancy circles.","id":"f1e0491a-6000-4a7e-a2e3-91854c1ed095"}],"categories":["English multiplicity slang"],"links":[["multiplicity","multiplicity#English:_multiple_personalities"],["headspace","headspace#English"]],"raw_glosses":["(multiplicity slang) Synonym of headspace."],"qualifier":"multiplicity slang","glosses":["Synonym of headspace."],"synonyms":[{"word":"headspace","tags":["synonym","synonym-of"]}],"id":"4546a20e-38c2-4102-a6f5-3b58f7bb9a42"}],"related":[],"synonyms":[]},"wone":{"id":"bb166e8a-1ea1-4fee-9fc3-312fdb7bf787","word":"wone","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"to live, reside, stay","word":"morar"}],"pos":"verb","tags":null,"senses":[{"examples":[{"text":"This I make thi wonnyng playce, / ffull of myrth and of solace","ref":"15th c., “[The Creation]”, in Wakefield Mystery Plays; Re-edited in George England, Alfred W. Pollard, editors, The Towneley Plays (Early English Text Society Extra Series; LXXI), London: […] Oxford University Press, 1897, →OCLC, page 6:","english":"This I make thy dwelling place, full of mirth and solace","type":"quotation","bold_text_offsets":[[16,23]],"translation":"This I make thy dwelling place, full of mirth and solace","id":"b552de25-d884-4fc6-a622-ea6748b93280"},{"text":"For now the best and noblest knight alive\nPrince Arthur is, that wonnes in Faerie Lond;\nHe hath a sword, that flames like burning brond.","ref":"1596, Edmund Spenser, The Faerie Queene, Volume 2, iii:18 (see also i:51, vii:49, ix:52, and xii:69)","id":"5bdb5ab1-2a7c-4cb8-8875-6e8469e3ba8f"},{"text":"Then we entered the city and found all who therein woned into black stones enstoned[…]","ref":"1885, Sir Richard Burton, The Book of the Thousand Nights and a Night, Night 17:","type":"quotation","bold_text_offsets":[[51,56]],"id":"0a23781d-343c-488f-a810-fc23f59e4304"}],"categories":["English dialectal terms","English terms with archaic senses","English terms with obsolete senses","English terms with quotations","Middle English terms with quotations","Quotation templates to be cleaned"],"links":[["live","live"],["reside","reside"],["stay","stay"]],"raw_glosses":["(obsolete or archaic, dialectal) To live, reside, stay."],"glosses":["To live, reside, stay."],"tags":["archaic","dialectal","obsolete"],"id":"faf985c2-96f7-4d7c-a1d8-0bda11492ab9"}],"related":[],"synonyms":[]},"wonder of the world":{"id":"a017bea7-b960-4e6b-a24a-3f3674bd37dd","word":"wonder of the world","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"something remarkable in the world","tags":["feminine"],"word":"maravilha do mundo"}],"pos":"noun","tags":null,"senses":[{"examples":[{"text":"Bart spies an opportunity to make a quick buck so he channels his inner carny and posits his sinking house as a natural wonder of the world and its inhabitants as freaks, barking to dazzled spectators, “Behold the horrors of the Slanty Shanty! See the twisted creatures that dwell within! Meet Cue-Ball, the man with no hair!”","ref":"2012 May 20, Nathan Rabin, “TV: Review: THE SIMPSONS (CLASSIC): “Marge Gets A Job” (season 4, episode 7; originally aired 11/05/1992)”, in The Onion AV Club:","type":"quotation","bold_text_offsets":[[120,139]],"id":"6925b69b-b603-47a0-ae25-46fa6a151194"}],"links":[["structure","structure"],["natural","natural"],["feature","feature"],["collection","collection"],["entities","entity"],["seven","seven"]],"synonyms":[{"word":"stupor mundi"},{"word":"world wonder"}],"categories":["English countable nouns","English entries with incorrect language header","English lemmas","English multiword terms","English nouns","English terms with quotations","Entries with translation boxes","Pages with 1 entry","Pages with entries","Terms with Dutch translations","Terms with German translations","Terms with Hungarian translations","Terms with Latvian translations","Terms with Polish translations","Terms with Portuguese translations","Terms with Tagalog translations"],"glosses":["A structure or natural feature considered to be one of the greatest of its kind; especially as part of a collection of related entities, usually having seven members."],"id":"eb17088d-caf8-40e7-ac34-dbe8f33e17fe"}],"related":[],"synonyms":[]},"wondergoal":{"id":"079a940f-d883-470d-920c-4968c176db7b","word":"wondergoal","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"a spectacular goal in football","word":"golaço"}],"pos":"noun","tags":null,"senses":[{"topics":["hobbies","lifestyle","sports"],"categories":["English compound terms","English countable nouns","English entries with incorrect language header","English informal terms","English lemmas","English nouns","Entries with translation boxes","Pages with 1 entry","Pages with entries","Terms with Japanese translations","Terms with Korean translations","Terms with Portuguese translations","Terms with Spanish translations","en:Sports"],"links":[["sports","sports"],["goal","goal"]],"raw_glosses":["(sports, informal) An excellent goal."],"glosses":["An excellent goal."],"tags":["informal"],"id":"35774544-e15f-44cd-880b-20aeb08df491"}],"related":[],"synonyms":[]}}
