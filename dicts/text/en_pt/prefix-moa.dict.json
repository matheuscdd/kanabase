 Inne”, in Comedies and Tragedies […], London: […] Humphrey Robinson, […], and for Humphrey Moseley […], published 1647, →OCLC, Act V, scene i:","type":"quotation","bold_text_offsets":[[17,22]],"id":"cd596f51-f1f7-4ca6-8807-c63a611c7275"}],"attestations":[{"date":"15th–17th c.","references":[]}],"categories":["English terms with obsolete senses","English terms with quotations","English transitive verbs"],"links":[["distress","distress"],["sadden","sadden"]],"synonyms":[{"word":"deject"},{"word":"aggrieve","source":"Thesaurus:sadden"},{"word":"attrist","source":"Thesaurus:sadden","tags":["archaic"]},{"word":"begloom","source":"Thesaurus:sadden","tags":["archaic"]},{"word":"begrieve","source":"Thesaurus:sadden","tags":["archaic"]},{"word":"besorrow","source":"Thesaurus:sadden"},{"word":"grieve","source":"Thesaurus:sadden"},{"word":"pain","source":"Thesaurus:sadden"},{"word":"bring down","source":"Thesaurus:sadden"},{"word":"come down on","source":"Thesaurus:sadden"},{"word":"contristate","source":"Thesaurus:sadden","tags":["obsolete"]},{"word":"darken","source":"Thesaurus:sadden"},{"word":"dash","source":"Thesaurus:sadden"},{"word":"deject","source":"Thesaurus:sadden"},{"word":"depress","source":"Thesaurus:sadden"},{"word":"desolate","source":"Thesaurus:sadden"},{"word":"dispirit","source":"Thesaurus:sadden"},{"word":"engrieve","source":"Thesaurus:sadden","tags":["archaic"]},{"word":"forset","source":"Thesaurus:sadden","tags":["UK","dialectal","figuratively"]},{"word":"get down","source":"Thesaurus:sadden"},{"word":"grieven","source":"Thesaurus:sadden"},{"word":"moan","source":"Thesaurus:sadden","tags":["obsolete"]},{"word":"oppress","source":"Thesaurus:sadden"},{"word":"repent","source":"Thesaurus:sadden","tags":["archaic"]},{"word":"rue","source":"Thesaurus:sadden","tags":["obsolete"]},{"word":"sadden","source":"Thesaurus:sadden"},{"word":"sadden up","source":"Thesaurus:sadden"},{"word":"tristitiate","source":"Thesaurus:sadden","tags":["obsolete"]},{"word":"ungladde