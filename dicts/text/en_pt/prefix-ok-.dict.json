{"OK":{"id":"0e5bf7f4-2a8c-411a-9e78-f67928723bde","word":"OK","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"acknowledgement or acceptance","word":"OK"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"acknowledgement or acceptance","word":"tudo bem"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"acknowledgement or acceptance","word":"tá"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"acknowledgement or acceptance","word":"certo"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"introduction of a sentence in order to draw attention","word":"tá"}],"pos":"intj","tags":null,"senses":[{"examples":[{"text":"I promise to give it back. – OK.","bold_text_offsets":[[29,31]],"type":"example","id":"72c08b64-b7e1-4bb3-96ba-a4e620c602a2"},{"text":"Let's meet again this afternoon. – OK.","bold_text_offsets":[[35,37]],"type":"example","id":"02690853-abe6-4561-869d-0077be19d836"},{"text":"Shut up! – OK, OK.","bold_text_offsets":[[11,13],[15,17]],"type":"example","id":"86b734c7-f988-4ba9-9fa8-c1749d5a1b60"},{"text":"OK! I get it! Stop nagging me!","bold_text_offsets":[[0,3]],"type":"example","id":"483b8d61-2cd9-4fe9-82ac-17e2ff12a04c"},{"text":"Come by this afternoon. — Okay.","ref":"2016, VOA Learning English (public domain)","id":"9e8a5cab-0197-4b9e-aa12-d627cfdc3ab1"}],"synonyms":[{"word":"okey-dokey"},{"word":"okeh"},{"word":"okey"},{"word":"k"},{"word":"'kay"},{"word":"m'kay"},{"word":"A-OK"},{"word":"all right"}],"glosses":["Used to indicate acknowledgement or acceptance."],"categories":["English terms with usage examples"],"id":"05243fd3-cb30-4123-8d61-ce4c6fd895a6"},{"topics":["computing","engineering","mathematics","natural-sciences","physical-sciences","sciences"],"categories":["en:Computing"],"links":[["computing","computing#Noun"],["dialog box","dialog box#English"],["prompt","prompt#English"]],"raw_glosses":["(computing) Used to dismiss a dialog box or confirm a prompt."],"glosses":["Used to dismiss a dialog box or confirm a prompt."],"id":"df7f8277-6f6d-4652-9daa-c92da1956954"},{"examples":[{"text":"OK, I'm thinking of a number…","bold_text_offsets":[[0,2]],"type":"example","id":"302e47a6-b2eb-48cd-aff7-7f65b1223203"}],"synonyms":[{"word":"now"},{"word":"now then"}],"glosses":["Used to introduce a sentence in order to draw attention to the importance of what is being said."],"categories":["English terms with usage examples"],"id":"66f157f4-f41d-48ed-9135-247b91ccc7b8"},{"examples":[{"text":"You always do this to me! When we were at your mother’s, you said that… – OK, OK, …","bold_text_offsets":[[74,76],[78,80]],"type":"example","id":"8c9793e3-ad17-411f-aa63-8e5ce323607a"}],"links":[["turn-taking","w:turn-taking"]],"glosses":["Used in turn-taking, serving as a request to the speaker to grant the turn to the interrupter."],"categories":["English terms with usage examples"],"id":"c4086d47-d13a-496c-82c1-7ef958003ae4"},{"glosses":["Used to sarcastically or sardonically indicate agreement with the previous statement."],"id":"af806c07-8c69-402a-b3ce-48bdba3cb1e1"}],"related":[{"word":"oll korrect"},{"word":"👌"}],"synonyms":[]}}
