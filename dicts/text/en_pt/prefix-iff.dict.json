{"iff":{"id":"4852ca6a-6895-49cb-98ba-8e3988bc02e0","word":"iff","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"abbreviation of if and only if","word":"sse"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"abbreviation of if and only if","word":"sss"}],"pos":"conj","tags":null,"senses":[{"examples":[{"text":"A rectangle is a square iff all four of its sides have the same length.","bold_text_offsets":[[24,27]],"type":"example","id":"ebe7f8d7-6039-440a-862d-0cf738e65e0d"}],"topics":["human-sciences","logic","mathematics","philosophy","sciences"],"categories":["English abbreviations","English terms with usage examples","en:Logic","en:Mathematics"],"links":[["mathematics","mathematics"],["logic","logic"],["if and only if","if and only if#English"]],"raw_glosses":["(mathematics, logic) Abbreviation of if and only if."],"glosses":["Abbreviation of if and only if."],"tags":["abbreviation","alt-of"],"alt_of":[{"word":"if and only if"}],"id":"ce07cca6-a0ce-4a6d-8bec-be323811e7eb"}],"related":[{"word":"if"}],"synonyms":[]},"iffy":{"id":"72f70a8c-6fb1-4eee-9230-92380a3a57d4","word":"iffy","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"Of dubious authenticity, legitimacy or legality","tags":["masculine"],"word":"suspeito"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"Of dubious authenticity, legitimacy or legality","word":"dúbio"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"Of dubious authenticity, legitimacy or legality","word":"questionável"}],"pos":"adj","tags":null,"senses":[{"examples":[{"text":"He's selling new CD players for £20 each – that sounds a bit iffy to me.","bold_text_offsets":[[61,65]],"type":"example","id":"95155125-5fa4-4c22-9080-ee3b7a65518f"}],"categories":["English slang","English terms with usage examples"],"links":[["dubious","dubious"],["authenticity","authenticity"],["legitimacy","legitimacy"],["legality","legality"]],"synonyms":[{"word":"dodgy"},{"word":"dubious"},{"word