rans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"an amount is as large as another amount","word":"tanto quanto"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"even though; despite the fact that","word":"por mais que"}],"pos":"conj","tags":null,"senses":[{"examples":[{"text":"Take as much as you like.","bold_text_offsets":[[5,15]],"type":"example","id":"a42d073a-ed8c-4c08-896b-4abb3cfba0a6"}],"links":[["as","as#English"],["much","much#English"]],"glosses":["Used other than figuratively or idiomatically: see as, much."],"categories":["English terms with usage examples"],"id":"3361f735-3d97-49e9-82ea-4a554edf83ec"},{"examples":[{"text":"He likes caramel as much as he likes fudge.","bold_text_offsets":[[17,27]],"type":"example","id":"ba210c3f-3de9-4dcb-b113-82d158c3887a"},{"text":"The second union panel, \"The Future of Clerical and Service Work: Unionization,\" consisted entirely of union organizers […] each stressed the need for grassroots organizing, coalitions, and community involvement, and seemed to view the government as an adversary as much as an ally.","ref":"1985 December 7, Pam Mitchell, Stephanie Poggi, “Feminists & the State Discuss Women at Work”, in Gay Community News, volume 13, number 21, page 6:","type":"quotation","bold_text_offsets":[[263,273]],"id":"c01c886e-6260-4ce6-87b6-a3edee1cac27"}],"categories":["English terms with quotations","English terms with usage examples"],"glosses":["Used to say that two things are equal in amount or degree"],"id":"6ed8bf47-06fe-42ef-9498-1d1e4bd2198a"},{"examples":[{"text":"He earns nearly as much as she does.","bold_text_offsets":[[16,26]],"type":"example","id":"5e98f14b-a441-4f1c-ad9a-e345c4937ec6"}],"glosses":["Used to say that an amount is as large as another amount"],"categories":["English terms with usage examples"],"id":"a9889b8d-5422-4bf0-ab43-76f4eb3d9232"},{"examples":[{"text":"As much as I dislike him, I still voted for him.","bold_text_offsets":[[0,10]],"type":"example","id":"5991caba-b17d-4b23-b793-f28ef37ab45a"},{"text":"For as much as the Downton Abbey alum has capitalized on his leading-man presentability—how suited he is to wearing suits—his best performances play deviously on that quality.","ref":"2021 September 16, A. A. Dowd, “Dan Stevens as a dashing robot lover? That computes”, in AV Club:","type":"quotation","bold_text_offsets":[[4,14]],"id":"729b9ac0-6a75-45ee-9675-f34a61bb43b2"}],"links":[["Even though","even though"],["much as","much as"]],"categories":["English terms with quotations","English terms with usage examples"],"glosses":["Even though; despite the fact that; much as."],"id":"ff649c21-741f-410a-a074-c19ea5f8a73d"}],"related":[{"word":"as few as"},{"word":"as little as"},{"word":"as many as"},{"word":"as much"},{"word":"much as"}],"synonyms":[{"sense":"even though","word":"although"},{"word":"much as"},{"word":"even though"}]}}
