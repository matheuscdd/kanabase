{"tagalog":{"id":"ecf911a0-3449-43b3-b668-301598993aac","word":"Tagalog","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"language","tags":["masculine"],"word":"tagalo"}],"pos":"name","tags":null,"senses":[{"links":[["Philippines","Philippines"]],"synonyms":[{"word":"Tagal"}],"glosses":["A language spoken in the Philippines, especially in areas of central to southern Luzon."],"id":"aa724244-47fd-4475-8a15-9da7257e0a34"}],"related":[],"synonyms":[]},"tag":{"id":"3532d5af-65c3-409f-9cda-82a628efe06c","word":"tag","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"to attach the name of a user so that they are linked from the post","word":"marcar"}],"pos":"verb","tags":null,"senses":[{"categories":["English transitive verbs"],"links":[["label","label"]],"raw_glosses":["(transitive) To label (something)."],"glosses":["To label (something)."],"tags":["transitive"],"id":"1ed45df5-ef16-4169-bed9-953cb07acb45"},{"categories":["English transitive verbs"],"links":[["graffiti","graffiti"]],"raw_glosses":["(transitive) To mark (something) with one's graffiti tag."],"glosses":["To mark (something) with one's graffiti tag."],"tags":["transitive"],"id":"0bd2e0ae-0dda-42f0-a3d0-f7f430cee67f"},{"examples":[{"text":"Regularly tag the rear ends of your sheep.","bold_text_offsets":[[10,13]],"type":"example","id":"1a479a36-be2d-4927-a1e3-09692f04f3f6"}],"categories":["English terms with usage examples","English transitive verbs"],"raw_glosses":["(transitive) To remove dung tags from a sheep."],"glosses":["To remove dung tags from a sheep."],"tags":["transitive"],"id":"f70ed988-7885-483d-8a86-d53fb9205a1a"},{"examples":[{"text":"He really tagged that ball.","bold_text_offsets":[[10,16]],"type":"example","id":"5fea3847-44a4-4303-87f0-5ea6dbf5de57"}],"topics":["ball-games","baseball","games","hobbies","lifestyle","sports"],"categories":["English colloquialisms","English terms with usage examples","English transitive verbs","en:Baseball"],"links":[["baseball","baseball"]],"raw_glosses":["(transitive, baseball, colloquial) To hit the ball hard."],"glosses":["To hit the ball hard."],"tags":["colloquial","transitive"],"id":"0bbad207-5c7a-4e16-8588-9b7fb11061d5"},{"examples":[{"text":"Steve is dying to tag Angie from chemistry class.","bold_text_offsets":[[18,21]],"type":"example","id":"f11a0a1b-4acb-4f0f-b625-4275b1468979"}],"categories":["English slang","English terms with usage examples","English transitive verbs","English vulgarities"],"raw_glosses":["(transitive, vulgar, slang, 1990s) to have sex with someone (especially a man of a woman)"],"glosses":["to have sex with someone (especially a man of a woman)"],"tags":["slang","transitive","vulgar"],"id":"b443dd06-339b-4758-9af7-5b1a83b024a4"},{"examples":[{"text":"He tagged the runner for the out.","bold_text_offsets":[[3,9]],"type":"example","id":"d318aa83-ecb2-47ac-ab7d-bb05ef16c536"}],"topics":["ball-games","baseball","games","hobbies","lifestyle","sports"],"categories":["English terms with usage examples","English transitive verbs","en:Baseball"],"links":[["baseball","baseball"]],"raw_glosses":["(transitive, baseball) To put a runner out by touching them with the ball or the ball in a gloved hand."],"glosses":["To put a runner out by touching them with the ball or the ball in a gloved hand."],"tags":["transitive"],"id":"b0e5a8d3-4a67-4e0f-adb1-9f9e37484da1"},{"examples":[{"text":"I am tagging my music files by artist and genre.","bold_text_offsets":[[5,12]],"type":"example","id":"b3a498a3-3292-4d48-9a33-1042bbf7820a"}],"topics":["computing","engineering","mathematics","natural-sciences","physical-sciences","sciences"],"categories":["English terms with usage examples","English transitive verbs","en:Computing"],"links":[["computing","computing#Noun"]],"antonyms":[{"word":"untag"}],"raw_glosses":["(transitive, computing) To mark with a tag (metadata for classification)."],"glosses":["To mark with a tag (metadata for classification)."],"tags":["transitive"],"id":"029f