ons","en:Sweets"],"glosses":["A sweet popular in the Indian subcontinent, made by deep-frying a maida flour batter and soaking it in sugar syrup."],"id":"4e9174b0-9720-4d0e-9df2-fbd01e314673"}],"related":[{"word":"zalabiya"}],"synonyms":[]},"Jalal-Abad":{"id":"4f4b161a-5339-4616-8d7a-ac490bdfffd8","word":"Jalal-Abad","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"Kyrgyz city","word":"Jalal-Abad"}],"pos":"name","tags":null,"senses":[{"wikidata":["Q487640"],"senseid":["en:Q487640"],"categories":["en:Places in Kyrgyzstan","en:Regions of Kyrgyzstan"],"links":[["region","region"],["Kyrgyzstan","Kyrgyzstan#English"]],"glosses":["A region of Kyrgyzstan."],"id":"090e8ec4-655e-4340-b68b-2293ebbd266c"},{"wikidata":["Q487689"],"senseid":["en:Q487689"],"categories":["en:Cities in Kyrgyzstan","en:Places in Kyrgyzstan","en:Regional capitals of Kyrgyzstan"],"links":[["capital city","capital city"],["Jalal-Abad","Jalal-Abad#English"],["Kyrgyzstan","Kyrgyzstan#English"]],"glosses":["The capital city of the Jalal-Abad Region, Kyrgyzstan."],"id":"ef4bec17-06a8-4853-aa6f-d33a3247dece"}],"related":[],"synonyms":[]}}
