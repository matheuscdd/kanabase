roke"],["lovingly","lovingly"]],"synonyms":[{"word":"dandle"},{"word":"pet"},{"word":"touch up"}],"raw_glosses":["(transitive) To touch or stroke lovingly."],"glosses":["To touch or stroke lovingly."],"tags":["transitive"],"id":"ad6ab045-ffc9-4b26-a62e-31f20df56d87"},{"examples":[{"text":"The lovers fondled each other.","bold_text_offsets":[[11,18]],"type":"example","id":"fbefb5b3-67b7-416c-ac9c-44b19b1ba887"}],"categories":["English terms with usage examples","English transitive verbs"],"links":[["grasp","grasp"]],"synonyms":[{"word":"clutch"},{"word":"grab"},{"word":"nim"},{"word":"beclasp","source":"Thesaurus:grasp","tags":["dated"]},{"word":"begrasp","source":"Thesaurus:grasp"},{"word":"begrip","source":"Thesaurus:grasp"},{"word":"belock","source":"Thesaurus:grasp","tags":["archaic"]},{"word":"clasp","source":"Thesaurus:grasp"},{"word":"clench","source":"Thesaurus:grasp"},{"word":"clinch","source":"Thesaurus:grasp"},{"word":"cling","source":"Thesaurus:grasp"},{"word":"clutch","source":"Thesaurus:grasp"},{"word":"enclasp","source":"Thesaurus:grasp"},{"word":"fang","source":"Thesaurus:grasp","tags":["archaic","dialectal"]},{"word":"fondle","source":"Thesaurus:grasp"},{"word":"glaum","source":"Thesaurus:grasp","tags":["dialectal"]},{"word":"grab","source":"Thesaurus:grasp"},{"word":"grabble","source":"Thesaurus:grasp"},{"word":"grasp","source":"Thesaurus:grasp"},{"word":"grip","source":"Thesaurus:grasp"},{"word":"hang on","source":"Thesaurus:grasp"},{"word":"hold on","source":"Thesaurus:grasp"},{"word":"hold tight","source":"Thesaurus:grasp"},{"word":"hold","source":"Thesaurus:grasp"},{"word":"nab","source":"Thesaurus:grasp"},{"word":"nim","source":"Thesaurus:grasp","tags":["obsolete"]},{"word":"seize","source":"Thesaurus:grasp"},{"word":"stranglehold","source":"Thesaurus:grasp"},{"word":"take","source":"Thesaurus:grasp"}],"raw_glosses":["(transitive) To grasp."],"glosses":["To grasp."],"tags":["transitive"],"id":"e16b1c5c-2d11-4e43-bdfd-0065ebaea388"}],"related":[