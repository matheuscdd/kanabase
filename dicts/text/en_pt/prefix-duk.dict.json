{"duke":{"id":"4414e0ca-05ef-4271-bf81-f30d8aa3ae37","word":"duke","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"male ruler of a duchy","tags":["masculine"],"word":"duque"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"male holder of a dukedom","tags":["masculine"],"word":"duque"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"grand duke","tags":["masculine"],"word":"grão-duque"}],"pos":"noun","tags":null,"senses":[{"links":[["male","male"],["ruler","ruler"],["duchy","duchy"],["duchess","duchess#English"]],"glosses":["The male ruler of a duchy (female equivalent: duchess)."],"id":"0946554c-1368-4dd6-9bc7-5d46b89e68f0"},{"links":[["sovereign","sovereign"],["small","small"],["state","state"]],"glosses":["The sovereign of a small state."],"id":"0c445115-5a9d-4722-805b-a088ca67d4f5"},{"links":[["high","high"],["title","title"],["nobility","nobility"],["male","male"],["holder","holder"],["dukedom","dukedom"]],"hypernyms":[{"word":"title"},{"word":"holder"}],"coordinate_terms":[{"word":"baron"},{"word":"count"},{"word":"countess"},{"word":"earl"},{"word":"jarl"},{"word":"marquis"},{"word":"marquess"},{"word":"viscount"},{"word":"prince"},{"word":"monarch"}],"glosses":["A high title of nobility; the male holder of a dukedom."],"id":"409f3cec-c24b-45d9-9b7f-b9dc24e28639"},{"links":[["grand duke","grand duke"]],"glosses":["A grand duke."],"id":"6da4a674-7b69-47fa-8347-f2d593b95f60"},{"categories":["Entries using missing taxonomic name (genus)"],"links":[["nymphalid","nymphalid"],["genera","genus"]],"glosses":["Any of various nymphalid butterflies of the Asian genera Bassarona and Dophla."],"id":"99b4da7f-8ad8-4318-8ba7-4ff5138cb453"},{"examples":[{"text":"Put up your dukes!","bold_text_offsets":[[12,17]],"type":"example","id":"a912d3ef-c662-4c44-9a1b-04b062e81cdb"},{"text":"“Your friend sure knows how to use his dukes. Biff, bang! One, two, and the copʼs on his ass!”","ref":"1952, Ralph Ellison, Invisible Man, Penguin Books (201