exceptional","exceptional"],["luck","luck"],["success","success"],["power","power"]],"raw_glosses":["(informal) Supernatural skill; exceptional luck, success, or power."],"glosses":["Supernatural skill; exceptional luck, success, or power."],"tags":["countable","informal","uncountable"],"id":"32539408-5dd6-4c6c-8da2-34b014cd6e0f"},{"examples":[{"text":"Still reeling from the 2023 Voice loss, Albanese struggled until the start of this year to regain his mojo. Polls relentlessly showed the prime minister was on the nose with voters weary over the cost of living.","ref":"2025 May 8, Jacob Greber, “How Peter Dutton’s Wile E Coyote campaign flew off the cliff”, in ABC News:","type":"quotation","bold_text_offsets":[[102,106]],"id":"98d9b553-a573-430f-bd6a-e2c3af1b1fde"}],"categories":["English slang","English terms with quotations"],"links":[["magnetism","magnetism"],["charm","charm"]],"raw_glosses":["(slang) Personal magnetism; charm; that which makes one successful and liked, viewed as an inherent power that can be present or absent."],"glosses":["Personal magnetism; charm; that which makes one successful and liked, viewed as an inherent power that can be present or absent."],"tags":["countable","slang","uncountable"],"id":"a0ba4a62-6c27-417d-97e9-61a8698ed697"},{"examples":[{"text":"Look at the way the chicks are checking out Daniel on the dancefloor. He's still got plenty of mojo.","bold_text_offsets":[[95,99]],"type":"example","id":"0e60f0a5-983e-4aec-a97c-07ab7ee809af"}],"categories":["English slang","English terms with usage examples"],"links":[["Sex appeal","sex appeal"],["sex drive","sex drive"]],"raw_glosses":["(slang) Sex appeal; sex drive."],"glosses":["Sex appeal; sex drive."],"tags":["countable","slang","uncountable"],"id":"600f4770-526a-4dda-aace-de3eb9b78a68"},{"categories":["English slang"],"links":[["illegal","illegal"],["drug","drug"],["morphine","morphine"],["narcotic","narcotic"]],"synonyms":[{"word":"recreational drug","source":"Thesaurus:recreationa