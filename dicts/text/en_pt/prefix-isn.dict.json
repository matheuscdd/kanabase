{"isn't":{"id":"d6dcbab2-caaa-4251-8866-0030a3965ab9","word":"isn't","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"is not","word":"não é"}],"pos":"verb","tags":null,"senses":[{"examples":[{"text":"Nice day, isn't it?","bold_text_offsets":[[10,15]],"type":"example","id":"6de54ce3-c1f5-4572-a18c-2bb7da8c3e12"},{"text":"I suppose she's hungry, isn't she?","bold_text_offsets":[[24,29]],"type":"example","id":"25fd5423-80ad-4f71-88ab-4d3074f47bcd"},{"text":"As we age, the major arteries of our bodies frequently become thickened with plaque, a fatty material with an oatmeal-like consistency that builds up along the inner lining of blood vessels. The reason plaque forms isn’t entirely known, but it seems to be related to high levels of cholesterol inducing an inflammatory response, which can also attract and trap more cellular debris over time.","ref":"2013 July-August, Stephen P. Lownie, David M. Pelz, “Stents to Prevent Stroke”, in American Scientist:","type":"quotation","bold_text_offsets":[[215,220]],"id":"b2adcad0-1deb-4415-b701-19ddc9409b62"}],"categories":["English contractions","English terms with quotations","English terms with usage examples"],"links":[["is","is#English"],["not","not#English"]],"glosses":["Contraction of is + not (negative auxiliary)."],"tags":["abbreviation","alt-of","contraction"],"alt_of":[{"word":"is","extra":"+ not (negative auxiliary)"}],"id":"418ece88-7fee-4a27-964e-1538303b15d9"}],"related":[],"synonyms":[]},"isn't it so":{"id":"cc5ecfad-ccdd-469c-b375-a8d7b07fc3ec","word":"isn't it so","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"isn't it so?","word":"não é?"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"isn't it so?","word":"né?"}],"pos":"phrase","tags":null,"senses":[{"synonyms":[{"word":"right?"}],"glosses":["Isn't it true?"],"id":"a17eefae-2c01-4377-9b6c-b373a6f0efb1"},{"glosses":["Isn't it that way?"],"id":"e8bf0fbe-4b2f-42ce-a949-d6b81ca9f73a"}],"related":[],"synonyms":[]}}
