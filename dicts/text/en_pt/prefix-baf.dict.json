{"baffled":{"id":"053d5668-28b4-4a94-b0bf-bb311c6a6903","word":"baffled","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"thoroughly confused, puzzled","word":"confuso"}],"pos":"adj","tags":null,"senses":[{"examples":[{"text":"She looked completely baffled by the puzzle.","bold_text_offsets":[[22,29]],"type":"example","id":"7b9b624c-9157-4db7-86e5-02c7603f84b1"},{"text":"The scientists were baffled by the unexpected results.","bold_text_offsets":[[20,27]],"type":"example","id":"41623541-842a-454b-91db-b8f456a7dec9"},{"text":"He was baffled when his keys disappeared.","bold_text_offsets":[[7,14]],"type":"example","id":"aa3cb890-6827-488f-90c3-3c20e4e48091"}],"links":[["confused","confused"],["puzzled","puzzled"]],"glosses":["Thoroughly confused, puzzled"],"categories":["English terms with usage examples"],"id":"ae6c1c38-efc8-439a-a27c-1236b11eb331"},{"links":[["baffle","baffle"]],"glosses":["Having baffles"],"id":"5b3350f0-d2bc-4de1-8f3c-30cb08586659"}],"related":[],"synonyms":[]},"baffle":{"id":"cd225c08-b915-40d5-ba3a-e022ce8fa590","word":"baffle","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"device used to control the movement of a fluid, or waves travelling through a fluid","tags":["masculine"],"word":"deflector"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"device used to control the movement of a fluid, or waves travelling through a fluid","tags":["feminine"],"word":"chicana"}],"pos":"noun","tags":null,"senses":[{"examples":[{"text":"Tanker trucks use baffles to keep the liquids inside from sloshing around.","bold_text_offsets":[[18,25]],"type":"example","id":"d5cf8fdf-2a29-4de5-b534-907e52bb13c4"}],"topics":["engineering","natural-sciences","physical-sciences","technology"],"categories":["English countable nouns","English terms with usage examples","en:Technology"],"links":[["technology","technology"],["device","device"],["used","use#Verb"],["dampen","dampen"],["muffle","muffle#Verb"],["restrain","restrain