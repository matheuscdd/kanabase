ually"],"id":"429f815e-9abd-4b67-add5-099794ecc2ed"},{"links":[["eating apple","eating apple"]],"glosses":["A red-skinned variety of eating apple."],"tags":["uncountable","usually"],"id":"2b8cf59b-384b-4532-ae7e-2d8b57c988d3"}],"related":[],"synonyms":[]},"jazzy":{"id":"44d2afa6-da02-47dc-ba36-0477f7f1ece0","word":"jazzy","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"flashy or showy","tags":["masculine"],"word":"claro"}],"pos":"adj","tags":null,"senses":[{"links":[["jazz","jazz"]],"glosses":["In the style of jazz."],"id":"a89a7fbf-c65e-4838-80e8-c9d99f525441"},{"links":[["Flashy","flashy"],["showy","showy"]],"glosses":["Flashy or showy."],"id":"4ad1f42d-04d8-4e74-8805-e2911d28b251"},{"examples":[{"text":"Your mother-of-pearl teeth, hard thighs, heaving ribcage — The smooth back of your adolescent neck, Your hot testicles swimming with future generations, And that rhinoceros horn there that makes you shiver all jazzy — You are where I get my fantasies, nigra.","ref":"1996, Daniel J. Wideman, Rohan B. Preston, Soulfires: Young Black Men on Love and Violence, page 189:","type":"quotation","bold_text_offsets":[[210,215]],"id":"48d68be6-9621-4152-aff6-ac3503469e3e"},{"text":"John was waiting in the health club's juice bar, wearing a gray pinstriped Oxford suit and a blue Hermes tie. \"You look all jazzy,\" Tyler said as he approached his partner. \"I got you a cup of coffee.\"","ref":"2005, Peter Thomas, The Den of the Assassin, →ISBN, page 247:","type":"quotation","bold_text_offsets":[[124,129]],"id":"5b42d5f5-88c2-4772-ba5f-1707dc24ee25"},{"text":"The letters seemed to go all jazzy on her and then they kept shifting, changing direction and making new patterns that she couldn't recognize.","ref":"2016, Laurence Fearnley, The Quiet Spectacular, →ISBN, page 109:","type":"quotation","bold_text_offsets":[[29,34]],"id":"04b8d195-aadc-407f-97a3-11c0cbfaeb4a"}],"links":[["focus","focus"],["jittery","jittery"],["jangly","jangly"]],"categories":["English terms with quotations"],"glosses":["Lacking focus; jittery or jangly."],"id":"b22726b8-5e21-4b85-b34d-bfb95cb7ab88"}],"related":[],"synonyms":[{"sense":"in the style of jazz","word":"jazzlike"},{"sense":"flashy or showy","word":"flashy"},{"word":"showy"},{"sense":"gaudy","word":"gaudy"},{"sense":"lacking focus","word":"jittery"},{"word":"jangling"}]},"jazzer":{"id":"8d71e358-2d57-466c-9db4-ac0145e25eec","word":"jazzer","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"a jazz musician","tags":["feminine","masculine"],"word":"jazzista"}],"pos":"noun","tags":null,"senses":[{"attestations":[{"date":"from 20th c.","references":[]}],"categories":["English colloquialisms","English terms with rare senses"],"links":[["energy","energy"],["pizzazz","pizzazz"]],"raw_glosses":["(colloquial, rare) Something with energy or pizzazz."],"glosses":["Something with energy or pizzazz."],"tags":["colloquial","rare"],"id":"83504325-2040-4895-96cf-528d2009e259"},{"examples":[{"text":"Unlike the players from the other scenes, however, the Cleveland jazzers would also engage in reflexive thought even when there are no immediate problems.","ref":"2004, Harris M. Berger, Giovanna Del Negro, Identity and everyday life, page 106:","type":"quotation","bold_text_offsets":[[65,72]],"id":"f4681ef8-a1b2-492b-a2f5-15b0c98c4417"},{"text":"Taking an opportunity to follow jazzer Paul Whiteman's band to Berlin, he remained in the German capital until Hitler's rise to power.","ref":"2021, Gavin Plumley, “A Boulevardier Writes…”, in Literary Review, 497, June:","type":"quotation","bold_text_offsets":[[32,38]],"id":"b4083fcb-6f82-441e-aa02-72c98245cfac"}],"attestations":[{"date":"from 20th c.","references":[]}],"categories":["English colloquialisms","English terms with quotations","Quotation templates to be cleaned"],"links":[["jazz","jazz"],["musician","musician"]],"raw_glosses":["(colloquial) A jazz musician; someone who likes or dances to jazz music."],"glosses":["A jazz musician; someone who likes or dances to jazz music."],"tags":["colloquial"],"id":"815e13c3-4b90-47ba-b70b-7f43ad0425c3"}],"related":[],"synonyms":[{"word":"jazzbo"},{"word":"jazzist"},{"word":"jazzman"},{"word":"jazzster"},{"word":"jazzperson"},{"word":"jitterbug"}]}}
