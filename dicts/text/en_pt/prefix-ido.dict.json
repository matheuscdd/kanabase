d_text_offsets":[[17,29]],"type":"example","id":"e2d1fc24-3a10-411a-a505-cb375c100826"}],"glosses":["Used to indicate that one is speculating (often used sarcastically when stating the obvious)."],"categories":["English terms with usage examples"],"id":"90783358-ab73-48fc-aba7-c36bb5ff76b5"},{"examples":[{"text":"The audacity of that lad... I don't know.","bold_text_offsets":[[28,40]],"type":"example","id":"eec1e69a-4866-4b40-8b57-82bba67e1f55"}],"categories":["British English","English terms with usage examples"],"raw_glosses":["(UK) Used to express exasperation or incredulity about a given situation or person."],"glosses":["Used to express exasperation or incredulity about a given situation or person."],"tags":["UK"],"id":"d43bad62-aec9-408b-9d2c-ed816a897a7d"},{"examples":[{"text":"I don't know why Blip just shuts off the power and then blames it on the weather.","ref":"1984, Alasdair, You Can't Do That on Television, Nickelodeon, season 5, episode 24","id":"f027ea3f-41d5-494f-942b-5aa74539b6db"}],"links":[["I","I#English"],["don't","don't#English"],["know","know#English"]],"glosses":["Used other than figuratively or idiomatically: see I, don't, know."],"id":"549a3b19-1bf1-4f4d-8d7d-de5c54eb8fa0"}],"related":[{"word":"what do I know"}],"synonyms":[]},"I don't understand":{"id":"0dd4f54f-a1e9-4446-8483-0b699c5c8904","word":"I don't understand","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"I don't understand","word":"eu não entendo"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"I don't understand","word":"não entendo"}],"pos":"phrase","tags":null,"senses":[{"links":[["speaker","speaker"],["understand","understand"],["situation","situation"]],"glosses":["Indicates that the speaker is not understanding the current subject or situation."],"categories":["English entries with incorrect language header","English lemmas","English multiword terms","English phrasebook","English phrases","English sentences","Entries with translation boxes"