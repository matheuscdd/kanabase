":[[10,18]],"type":"example","id":"f4bc0f35-4ef3-4332-909a-db172d6ea1f7"}],"links":[["noble","noble"],["hereditary","hereditary"],["aristocracy","aristocracy"]],"synonyms":[{"word":"aristocracy"},{"word":"noblesse"},{"word":"upper class"}],"antonyms":[{"word":"plebeian"}],"glosses":["A noble or privileged social class, historically accompanied by a hereditary title; aristocracy."],"categories":["English terms with usage examples"],"tags":["countable","uncountable"],"id":"88f25444-3ff4-4a9e-967b-1b93f6942b25"},{"examples":[{"text":"He displayed nobility of character when helping his rivals.","bold_text_offsets":[[13,21]],"type":"example","id":"5d262b17-dd0b-45a6-84e2-2e26e1c5ed9c"}],"categories":["English terms with usage examples","English uncountable nouns"],"links":[["noble","noble"]],"synonyms":[{"word":"aristocracy"},{"word":"nobleness"},{"word":"noblesse"}],"antonyms":[{"word":"meanness"},{"word":"ignobility"}],"raw_glosses":["(uncountable) The quality of being noble."],"glosses":["The quality of being noble."],"tags":["uncountable"],"id":"c4c7ef71-564c-4590-9708-1ff95ce3bfec"}],"related":[],"synonyms":[]},"no biggie":{"id":"a43c45a3-83cc-481e-869d-f8440e7370b2","word":"no biggie","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"not a big deal","word":"não ser grande coisa"}],"pos":"phrase","tags":null,"senses":[{"examples":[{"text":"It's no biggie. It should only take five minutes to make a new one.","bold_text_offsets":[[5,14]],"type":"example","id":"e990d7ea-fedc-4776-8d31-813aab451205"},{"text":"My teeth are, like, too small / But no biggie / It's so awesome","ref":"1982, Frank Zappa, Moon Zappa, “Valley Girl”, in Ship Arriving Too Late to Save a Drowning Witch:","type":"quotation","bold_text_offsets":[[36,45]],"id":"c83d4bce-756a-4d2d-bc46-3a360b2c4d81"}],"categories":["English colloquialisms","English entries with incorrect language header","English idioms","English lemmas","English multiword terms","English phrases","English terms with