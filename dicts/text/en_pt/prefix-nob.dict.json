l"],"id":"7e6b8b88-65cf-42a6-a67c-405d0d9fc104"}],"related":[{"word":"Nobel"},{"word":"Nobel prize"},{"word":"Nobelist"}],"synonyms":[{"word":"unnilbium"}]},"nob":{"id":"2eff06e3-1cae-4bcb-b6b7-72e2564fc17d","word":"nob","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"slang: head","tags":["feminine"],"word":"mona"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"jack of the same suit as the card turned up by the dealer","tags":["masculine"],"word":"trunfo"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"slang: glans penis","tags":["feminine"],"word":"ponta"}],"pos":"noun","tags":null,"senses":[{"examples":[{"text":"Jack and Jill went up the hill / to fetch a pail of water; / Jack fell down and broke his crown / and Jill came tumbling after. / Up Jack got and home did trot, / as fast as he could caper, / to old Dame Dob / to mend his nob / with vinegar and brown paper.","bold_text_offsets":[[222,225]],"type":"example","id":"86402c03-c4d4-411c-b41c-4c3415129c64"},{"text":"\"What a deep covey!\" said a greasy butcher with his mouth open, a red night-cap on his nob, and pointing towards Jacco Maccacco.","ref":"1870 [1821], Pierce Egan, Life in London, London: Chatto and Windus, page 261:","type":"quotation","bold_text_offsets":[[87,90]],"id":"1292c86d-2585-4f6d-aa18-13da2a485f96"}],"categories":["English slang","English terms with quotations","English terms with usage examples","Quotation templates to be cleaned"],"links":[["head","head"]],"raw_glosses":["(now only in slang) The head."],"qualifier":"now only in slang","glosses":["The head."],"id":"3eb0ffda-ff2b-40e7-ae15-d4ff228c788c"},{"examples":[{"text":"One for his nob.","bold_text_offsets":[[12,15]],"type":"example","id":"8ec8ba12-fdc0-41f4-8f77-b0b6bfb0feec"}],"categories":["English terms with usage examples","en:Cribbage"],"links":[["cribbage","cribbage"],["jack","jack"],["suit","suit"],["card","card"],["dealer","dealer"]],"synonyms":[{"word":"nibs"}],"raw_glosses":["(cribbage) A jack of the same suit as the card turned up by the dealer."],"qualifier":"cribbage","glosses":["A jack of the same suit as the card turned up by the dealer."],"id":"b60c0f1a-0048-4e88-983a-acc166aaebda"},{"categories":["English slang"],"links":[["glans penis","glans penis"],["penis","penis"],["knob","knob"]],"raw_glosses":["(slang) The glans penis, the sensitive bulbous structure at the end of the penis also known as the head of the penis. (Also spelled knob.)"],"glosses":["The glans penis, the sensitive bulbous structure at the end of the penis also known as the head of the penis. (Also spelled knob.)"],"tags":["slang"],"id":"2421475f-52ab-4947-b4f3-51f3c01bedd9"},{"categories":["British English","English slang","English vulgarities","Irish English"],"links":[["penis","penis"],["dick","dick"],["knob","knob"]],"raw_glosses":["(by extension) (vulgar, slang, chiefly UK, Ireland) The penis; dick. (Also spelled knob.)"],"glosses":["(vulgar, slang, chiefly UK, Ireland) The penis; dick. (Also spelled knob.)"],"tags":["broadly"],"id":"a6be10b8-86ff-4c10-8778-a07da9a820ef"},{"examples":[{"text":"Col wasn’t impressed with Dick’s patronising comments and turned his back and rolled his eyes whilst at the same time mumbling “Fucking nob, Dick by name Dick by nature” under his breath.","ref":"(Can we date this quote?), Philip Mumby, Halfway House, page 85:","type":"quotation","bold_text_offsets":[[136,139]],"id":"e6cd227f-9ddc-44df-ba4b-ff8d8da8290b"},{"text":"Christine would help Kelly with her submission so she didn’t look like a complete nob! And in exchange Kelly would introduce and talk Christine through some of her artistic works: giving her a personal guided tour from her earliest through to her latest pieces.","ref":"2012, Laura J. Harris, Splintered, page 40:","type":"quotation","bold_text_offsets":[[82,85]],"id":"731c0e32-893f-45d0-97ca-2461a4244249"},{"text":"I was in a garden […]A place no bloody nob could take away","ref":"2019 July 30, Elisa Braden, A Kiss from a Rogue:","type":"quotation","bold_text_offsets":[[39,42]],"id":"30f9bf08-9761-43b9-8b76-41f8cc678de3"}],"categories":["English derogatory terms","English terms with quotations","Requests for date"],"links":[["derogatory","derogatory"],["contemptible","contemptible"],["dick","dick"],["knob","knob"]],"raw_glosses":["(by extension, derogatory) A contemptible person; dick. (Also spelled knob.)"],"glosses":["A contemptible person; dick. (Also spelled knob.)"],"tags":["broadly","derogatory"],"id":"2fe09ae7-aae0-4f45-bc71-1d6e5ed0c445"},{"examples":[{"text":"The masses have risen up and shot all their nobs.","ref":"1989, Richard Curtis, Ben Elton, Blackadder Goes Forth:","type":"quotation","bold_text_offsets":[[44,48]],"id":"96022e40-b9ef-43ec-9d4b-e70031444297"}],"categories":["British English","English slang","English terms with quotations","Irish English","Quotation templates to be cleaned"],"links":[["wealthy","wealthy"],["influential","influential"],["toff","toff"]],"raw_glosses":["(slang, chiefly UK, Ireland) A wealthy or influential person; a toff."],"glosses":["A wealthy or influential person; a toff."],"tags":["Ireland","UK","slang"],"id":"2aa21af6-0cb4-4981-a7a2-b9a1e81bdaf0"},{"examples":[{"text":"He spoke with a lisp, occasioned by the loss of two of his large front teeth, which allowed the tongue as he talked to appear through the opening in a round nob like a raspberry.","ref":"1851, Henry Mayhew, London Labour and the London Poor, published 1861:","type":"quotation","bold_text_offsets":[[157,160]],"id":"62fc43d6-b2c9-40c2-9c40-2cee5e2ffe51"}],"categories":["English obsolete forms","English terms with quotations"],"links":[["knob","knob#English"]],"glosses":["Obsolete form of knob (“rounded protuberance”)."],"tags":["alt-of","obsolete"],"alt_of":[{"word":"knob","extra":"rounded protuberance"}],"id":"e64b5a83-5e3f-440a-91d0-bd564871273e"}],"related":[],"synonyms":[]},"noble":{"id":"d0aea512-c044-4a29-afcd-9b1abe5491f7","word":"noble","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"having honorable qualities","word":"nobre"}],"pos":"adj","tags":null,"senses":[{"examples":[{"text":"He made a noble effort.","bold_text_offsets":[[10,15]],"type":"example","id":"5fce69fc-5a9a-49e4-a37b-66b6ef4bc33b"},{"text":"He is a noble man who would never put his family in jeopardy.","bold_text_offsets":[[8,13]],"type":"example","id":"a92f7ee6-dbe7-4c35-a69b-34e6ee7bbd71"},{"text":"Korben, I realize you must be pretty mad at me. But I want you to know that I am fighting for a noble cause. / Yes, you're trying to save the world. I remember.","ref":"1997, 1:44:10 from the start, in The Fifth Element (Science Fiction / Action), →ISBN, →OCLC:","type":"quotation","bold_text_offsets":[[96,101]],"id":"c7131e0d-9e43-4f76-b0dc-2b106769ed8b"},{"text":"Wouldn't it be nobler by far to fight the good fight with all the weapons available: a firm bass voice, a wagging finger, the Bible?","ref":"2001 June 10, Walter Kim, “What Do You Tell The Kids?”, in TIME, archived from the original on 07 Mar 2016, retrieved 16 Jul 2014:","type":"quotation","bold_text_offsets":[[15,21]],"id":"47a1b55d-fa9a-4e7b-a2d2-79073a7d2f0c"}],"senseid":["en:honorably moral"],"links":[["honorable","honorable"],["eminence","eminence"],["petty","petty"],["mean","mean"],["dubious","dubious"]],"synonyms":[{"word":"great"},{"word":"honorable"}],"antonyms":[{"word":"despicable"},{"word":"ignoble"},{"word":"mean"},{"word":"vile"}],"categories":["English terms with quotations","English terms with usage examples"],"glosses":["Having honorable qualities; having moral eminence and freedom from anything petty, mean or dubious in conduct and character."],"id":"2a928503-d079-4412-a6a6-62d657093cab"},{"examples":[{"text":"a noble edifice","bold_text_offsets":[[2,7]],"type":"example","id":"791ae22f-a937-41d4-9210-837032bae477"},{"text":"He was thinking; but the glory of the song, the swell from the great organ, the clustered lights, […], the height and vastness of this noble fane, its antiquity and its strength—all these things seemed to have their part as causes of the thrilling emotion that accompanied his thoughts.","ref":"1918, W[illiam] B[abington] Maxwell, chapter V, in The Mirror and the Lamp, Indianapolis, Ind.: The Bobbs-Merrill Company, →OCLC:","type":"quotation","bold_text_offsets":[[135,140]],"id":"e0b30cc8-50fa-4308-9e34-3ef633f1f47c"}],"senseid":["en:splendid magnificent"],"links":[["Grand","grand#English"],["stately","stately"],["magnificent","magnificent"],["splendid","splendid"]],"glosses":["Grand; stately; magnificent; splendid."],"categories":["English terms with quotations","English terms with usage examples"],"id":"c5149351-9cb3-4b73-8f4a-2d28b9958e7c"},{"examples":[{"text":"noble blood; a noble personage","bold_text_offsets":[[0,5],[15,20]],"type":"example","id":"4713b7d0-9ba2-412d-9e7f-1576e70af37e"}],"links":[["exalted","exalted"],["rank","rank"],["nobility","nobility"],["distinguished","distinguished"],["mass","mass"],["birth","birth"],["highborn","highborn"]],"synonyms":[{"word":"superior"}],"antonyms":[{"word":"inferior"},{"word":"plebeian"}],"glosses":["Of exalted rank; of or relating to the nobility; distinguished from the masses by birth, station, or title; highborn."],"categories":["English terms with usage examples"],"id":"c608d44a-26b3-4500-a93d-46802de519a1"},{"topics":["chemistry","natural-sciences","physical-sciences"],"senseid":["en:chemically unreactive"],"categories":["en:Chemistry"],"links":[["chemistry","chemistry"]],"raw_glosses":["(chemistry) Of an element, unreactive."],"glosses":["Of an element, unreactive."],"id":"b3886f22-ce94-48b6-be39-b95051f3eb8d"},{"topics":["beverages","food","lifestyle","oenology","wine"],"categories":["en:Wine"],"links":[["wine","wine"],["grape","grape"],["cultivar","cultivar"],["winemaking","winemaking"],["Merlot","Merlot"],["Pinot Noir","Pinot Noir"],["Cabernet Sauvignon","Cabernet Sauvignon"],["Sauvignon blanc","Sauvignon blanc"],["Chardonnay","Chardonnay"]