{"jade":{"id":"98747474-5a8f-4d00-baab-9a4fe920938f","word":"jade","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"gem","tags":["masculine"],"word":"jade"}],"pos":"noun","tags":null,"senses":[{"examples":[{"text":"Although there are dozens of different types of gems, among the best known and most important are diamond, ruby and sapphire, emerald and other gem forms of the mineral beryl, chrysoberyl, tanzanite, tsavorite, topaz and jade.","ref":"2012 March 15, Lee A. Groat, “Gemstones”, in American Scientist, volume 100, number 2, archived from the original on 14 Jun 2012, page 128:","type":"quotation","bold_text_offsets":[[221,225]],"id":"2fc6f174-29b3-4f43-981a-260142a19621"}],"senseid":["en:gem"],"links":[["nephrite","nephrite"],["jadeite","jadeite"]],"synonyms":[{"word":"jadestone"},{"word":"jade stone"},{"word":"yu"},{"word":"jade-stone"}],"categories":["English terms with quotations"],"glosses":["A semiprecious stone, either nephrite or jadeite, generally green or white in color, often used for carving figurines."],"tags":["uncountable","usually"],"id":"6aaf5a27-f7a1-493f-b1d4-8992a41e59bb"},{"synonyms":[{"word":"jade green"}],"glosses":["A bright shade of slightly bluish or greyish green, typical of polished jade stones."],"tags":["uncountable","usually"],"id":"96cc6cd6-28d1-4776-9b70-3c7983e9c5dc"},{"categories":["Entries using missing taxonomic name (species)"],"links":[["succulent","succulent"],["plant","plant"]],"synonyms":[{"word":"jade plant"},{"word":"lucky plant"},{"word":"money plant"},{"word":"money tree"}],"glosses":["A succulent plant, Crassula ovata."],"tags":["uncountable","usually"],"id":"116e2317-1f02-4568-9e17-4d6ec7e89977"}],"related":[{"word":"agate"},{"word":"californite"},{"word":"greenstone"},{"word":"nephrite"},{"word":"quartz"},{"word":"serpentine"},{"word":"yulan"}],"synonyms":[]},"jaded":{"id":"42a01b77-142d-45f7-a25c-6f0fb9d13220","word":"jaded","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"W