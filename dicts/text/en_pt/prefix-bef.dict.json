:[{"text":"Will it be possible to have access to the room beforehand so that we can set up chairs?","bold_text_offsets":[[47,57]],"type":"example","id":"53214a52-7eef-495e-af54-8eb381ab6cb3"},{"text":"I love playing tennis but I always get so nervous beforehand.","bold_text_offsets":[[50,60]],"type":"example","id":"b830c6b1-feb5-4dad-ad15-4737c318ef90"},{"text":"Weeks beforehand, I had bought the tickets for the concert.","bold_text_offsets":[[6,16]],"type":"example","id":"03de08d8-737c-46f8-9791-b916c977b726"},{"text":"Prosecutors also said Wednesday their side “does not intend to reference allegations that the defendant violated FARA or improperly coordinated with the Obama Administration,” referring to the Foreign Agents Registration Act, which requires people who lobby on behalf of foreign clients to register beforehand with the US government.","ref":"2024 August 7, Marshall Cohen, “Prosecutors claim Hunter Biden once agreed to lobby US on behalf of Romanian businessman”, in CNN:","type":"quotation","bold_text_offsets":[[299,309]],"id":"5075c22b-0bfa-488e-b0c8-fe364e2ced4e"}],"links":[["earlier","earlier"],["preceding","preceding"],["time","time"]],"synonyms":[{"word":"in advance"},{"word":"upfront"},{"word":"prehand","tags":["nonstandard"]}],"antonyms":[{"word":"afterwards"},{"word":"afterhand","tags":["archaic"]}],"categories":["English terms with quotations","English terms with usage examples"],"glosses":["At an earlier or preceding time."],"tags":["not-comparable"],"id":"bc157a57-e20f-4818-9ecb-cb847dac38ba"}],"related":[],"synonyms":[]},"befuddle":{"id":"4e37340e-7547-4fab-b1a4-27d93abfbef7","word":"befuddle","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"perplex or confuse","word":"confundir"}],"pos":"verb","tags":null,"senses":[{"examples":[{"text":"The explanation left him completely befuddled.","bold_text_offsets":[[36,45]],"type":"example","id":"148f0539-d673-445b-9027-049dcc224512"},{"text":"Slowly the ape-man picked out the meaning of the various combinations of letters on the printed page, and as he read, the little bugs, for as such he always thought of the letters, commenced to run about in a most confusing manner, blurring his vision and befuddling his thoughts.","ref":"1916, Edgar Rice Burroughs, “The Nightmare”, in Jungle Tales of Tarzan, A. C. McClurg:","type":"quotation","bold_text_offsets":[[256,266]],"id":"f296f048-8fc0-4b7a-beaf-d7215f1b0651"}],"categories":["English terms with quotations","English terms with usage examples","English transitive verbs"],"links":[["perplex","perplex"],["confuse","confuse"]],"synonyms":[{"word":"addle","source":"Thesaurus:confuse"},{"word":"baffle","source":"Thesaurus:confuse"},{"word":"lose","source":"Thesaurus:confuse"},{"word":"embroil","source":"Thesaurus:confuse"},{"word":"stick","source":"Thesaurus:confuse"},{"word":"stump","source":"Thesaurus:confuse"},{"word":"baffound","source":"Thesaurus:confuse"},{"word":"bamboozle","source":"Thesaurus:confuse"},{"word":"bedevil","source":"Thesaurus:confuse"},{"word":"befuddle","source":"Thesaurus:confuse"},{"word":"throw","source":"Thesaurus:confuse"},{"word":"bemud","source":"Thesaurus:confuse","tags":["figuratively"]},{"word":"bemuse","source":"Thesaurus:confuse"},{"word":"bewilder","source":"Thesaurus:confuse"},{"word":"bumfuzzle","source":"Thesaurus:confuse"},{"word":"complicate","source":"Thesaurus:confuse"},{"word":"confound","source":"Thesaurus:confuse"},{"word":"confuddle","source":"Thesaurus:confuse","tags":["slang"]},{"word":"confuse","source":"Thesaurus:confuse"},{"word":"confuzzle","source":"Thesaurus:confuse","tags":["childish","slang"]},{"word":"dazzle","source":"Thesaurus:confuse"},{"word":"discombobulate","source":"Thesaurus:confuse"},{"word":"disconcert","source":"Thesaurus:confuse"},{"word":"blind","source":"Thesaurus:confuse"},{"word":"dumbfound","source":"Thesaurus:confuse"},{"word":"entangle","source":"Thesaurus:confuse","tags":["figuratively"]},{"word":"ferhoodle","source":"Thesauru