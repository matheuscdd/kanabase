{"nauru":{"id":"075fe590-a0b1-4c2b-81b0-841474bcf8f6","word":"Nauru","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"Republic of Nauru","tags":["masculine"],"word":"Nauru"}],"pos":"name","tags":null,"senses":[{"examples":[{"text":"The announcement Wednesday said those seeking refuge would all now be processed on the island nation of Nauru, another country that has been doing that work for Australia.","ref":"2021 October 6, Isabella Kwai, “Australia to Shift All Offshore Processing of Migrants to Island Nation of Nauru”, in The New York Times (Australia section), New York, N.Y.: The New York Times Company, →ISSN, →OCLC, archived from the original on 06 Oct 2021:","type":"quotation","bold_text_offsets":[[104,109]],"id":"74314217-985a-475c-a7cd-10be2220b10f"}],"wikidata":["Q697"],"senseid":["en:Q697"],"categories":["English terms with quotations","en:Countries in Oceania","en:Islands","en:Nauru"],"links":[["country","country"],["island","island"],["Oceania","Oceania#English"],["Pacific Ocean","Pacific Ocean"],["Republic of Nauru","Republic of Nauru#English"]],"glosses":["A country and island of Oceania, in the Pacific Ocean. Official name: Republic of Nauru."],"id":"00a63aab-d7f1-4afd-9b91-bbbb1af26f59"},{"links":[["Nauruan","Nauruan"]],"glosses":["Nauruan, the language of Nauru."],"id":"6dc68aca-b434-4046-87d4-0ceabf2110c7"}],"related":[{"word":"Countries of the world"}],"synonyms":[]},"nauruan":{"id":"32ba94bd-790f-4937-9e98-991505118460","word":"Nauruan","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"language of Nauru","tags":["masculine"],"word":"nauruano"}],"pos":"name","tags":null,"senses":[{"glosses":["the language of Nauru"],"id":"a65ab960-9215-46f5-8a16-ccdb73a703c9"}],"related":[{"word":"Wiktionary’s coverage of Nauruan terms"}],"synonyms":[]},"nautical":{"id":"43293a73-7fda-4582-be62-9ee226a7bad9","word":"nautical","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"relating to ships, shipping, navigat