{"baptism":{"id":"9d33dbc3-1a97-4b5e-b6c3-5e0a4cd6474a","word":"baptism","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"Christian sacrament","tags":["Brazil","masculine"],"word":"batismo"},{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"Christian sacrament","tags":["Portugal","masculine"],"word":"baptismo"}],"pos":"noun","tags":null,"senses":[{"examples":[{"text":"The child’s baptism was held at the old church.","bold_text_offsets":[[12,19]],"type":"example","id":"d359390c-c8fc-4360-bedb-ebabf49975b2"},{"text":"The ceremony of baptism symbolizes spiritual rebirth.","bold_text_offsets":[[16,23]],"type":"example","id":"6abefb97-b575-4d57-8f09-d2f59c35f686"}],"topics":["Christianity"],"wikidata":["Q35856"],"senseid":["en:Q35856"],"categories":["English terms with usage examples","en:Christianity"],"links":[["Christianity","Christianity"],["Christian","Christian"],["sacrament","sacrament"],["church","church"],["name","name"],["anoint","anoint"],["submerge","submerge"],["water","water"]],"synonyms":[{"word":"christening"}],"raw_glosses":["(Christianity) A Christian sacrament, by which one is received into a church and sometimes given a name, generally involving the candidate to be anointed with or submerged in water."],"glosses":["A Christian sacrament, by which one is received into a church and sometimes given a name, generally involving the candidate to be anointed with or submerged in water."],"tags":["countable","uncountable"],"id":"6f06ade8-95fe-4c71-97be-28695bb6715e"},{"links":[["ceremony","ceremony"],["initiation","initiation"],["purification","purification"],["naming","naming"]],"glosses":["A similar ceremony of initiation, purification or naming."],"tags":["countable","uncountable"],"id":"7c8a113b-89a1-4409-8eba-24163e76429a"},{"topics":["human-sciences","philosophy","sciences"],"categories":["en:Philosophy"],"links":[["philosophy","philosophy"],["moment","moment"],["object","object"],["assigned","assigned"],["proper name","prope