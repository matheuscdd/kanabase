{"if and only if":{"id":"a76eaed1-7c14-452a-a51d-63aaa5f282f7","word":"if and only if","trans":[{"lang":"Portuguese","code":"pt","lang_code":"pt","sense":"implies and is implied by","word":"se e somente se"}],"pos":"conj","tags":null,"senses":[{"examples":[{"text":"A rectangle is a square if and only if all four of its sides have the same length.","bold_text_offsets":[[24,38]],"type":"example","id":"45dd5a50-69f1-4a69-8046-99efd00ec9f4"},{"text":"An integer is even if and only if its square is also even.","bold_text_offsets":[[19,33]],"type":"example","id":"88c4477c-89ef-4098-bc4b-39cea51c2ab3"}],"topics":["human-sciences","logic","mathematics","philosophy","sciences"],"categories":["English terms with usage examples","en:Logic","en:Mathematics"],"links":[["logic","logic"],["mathematics","mathematics"],["equivalent","equivalent"],["implies","imply"],["true","true"],["false","false"]],"raw_glosses":["(logic, mathematics) Is equivalent to; implies and is implied by; is true and false in the same cases as."],"glosses":["Is equivalent to; implies and is implied by; is true and false in the same cases as."],"id":"63784f02-6a6a-4390-ab39-a2cabe9abccb"},{"examples":[{"text":"I'll let you go to the concert if and only if you clean your room.","bold_text_offsets":[[31,45]],"type":"example","id":"f2f975c0-cb1e-4b63-a593-8f19fb625115"}],"categories":["English informal terms","English terms with usage examples"],"links":[["if","if#English"]],"raw_glosses":["(by extension, informal) Synonym of if (with added intensity)"],"glosses":["Synonym of if (with added intensity)"],"tags":["broadly","informal"],"synonyms":[{"word":"if","extra":"with added intensity","tags":["synonym","synonym-of"]}],"id":"42b3a199-e23b-4a64-8537-28a5c5b47cb7"}],"related":[{"word":"if"},{"word":"if and when"},{"word":"iff"},{"word":"only if"},{"word":"when and only when"},{"word":"↔"},{"word":"⇔"}],"synonyms":[]}}
