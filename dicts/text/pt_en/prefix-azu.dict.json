{"azul":{"id":"c3b0438f-f3ac-46b9-8a81-9000f84f0468","word":"azul","trans":[{"lang_code":"en","lang":"Inglês","word":"blue"}],"pos":"noun","tags":["masculine"],"senses":[{"glosses":["cor do espectro visível; a cor do oceano, do céu, etc"],"raw_tags":["Cor"],"categories":["Cor (Português)"]}],"related":[],"synonyms":[]},"azulado":{"id":"7515c5a7-6bce-4973-b650-d937585f52fb","word":"azulado","trans":[{"lang_code":"en","lang":"Inglês","word":"bluish"}],"pos":"adj","tags":null,"senses":[{"glosses":["de cor azul ou de tonalidade semelhante à cor azul"],"examples":[{"text":"A visão entrevista do céu azulado pelo sol, do rio azulado pelo céu devia confundir-se-lhe, nos sonhos da pátria redimida, com o emblema recente das suas estreias na vitória. - Obras Seletas, volume 8. Rui Barbosa.","bold_text_offsets":[[26,33],[51,58]]}]}],"related":[],"synonyms":[]},"azul genciana":{"id":"2768269a-852f-4ec7-8c23-33e913c957af","word":"azul genciana","trans":[{"lang_code":"en","lang":"Inglês","word":"gentian blue"}],"pos":"phrase","tags":["masculine","substantive"],"senses":[{"glosses":["azul de tonalidade semelhante ao das flores da planta herbácea genciana"]}],"related":[],"synonyms":[]},"azurite":{"id":"fcba30f3-6e2b-44b4-9e1c-58315b7cbb14","word":"azurite","trans":[{"lang_code":"en","lang":"Inglês","word":"azurite"}],"pos":"noun","tags":["feminine"],"senses":[{"glosses":["o mesmo que azurita"]}],"related":[],"synonyms":[]},"azul-celeste":{"id":"53b698a4-083e-40a9-a13a-ce97bdb76a85","word":"azul-celeste","trans":[{"lang_code":"en","lang":"Inglês","word":"blue sky"},{"lang_code":"en","lang":"Inglês","word":"cerulean"},{"lang_code":"en","lang":"Inglês","word":"sky-blue"}],"pos":"noun","tags":["masculine"],"senses":[{"glosses":["cor baseada nas tonalidades azuis do céu diurno, azul brilhante, que vão desde o azul-bebê até tons de azul bem escuro como o azul-ultramarino; foi originalmente criada a partir da moagem da azurita, um pigmento usado desde o Egito Antigo; situa-se próximo ao ciano; é cor frequente na natureza em borboletas e pássaros, e está nos capacetes-azuis da ONU; é a cor do Dragão Azul na mitologia chinesa e representa a primavera e o ocidente, na Coreia, sendo a cor oficial da seleção italiana de futebol"],"raw_tags":["Cor"],"categories":["Cor (Português)"],"examples":[{"text":"(azul","translation":"celeste padrão)"},{"text":"(tonalidade azul","translation":"bebê)"}]}],"related":[],"synonyms":[{"word":"azul-cerúleo"}]},"azul-de-bromofenol":{"id":"6af54eb0-d5dc-417e-8068-6e2cb13989d8","word":"azul-de-bromofenol","trans":[{"lang_code":"en","lang":"Inglês","word":"bromophenol blue"}],"pos":"noun","tags":null,"senses":[{"glosses":["corante utilizado, dentre outras coisas, para monitorar a migração de moléculas em experimentos com fragmentos de DNA; atua como indicador de pH que vira entre o pH 3,0 e 4,6 de amarelo-azul para violeta, respectivamente"]}],"related":[],"synonyms":[{"word":"tetrabromofenolsulfonftaleína"}]},"azulejo":{"id":"c47c1875-427f-41a4-8afe-6dc8d32b5c96","word":"azulejo","trans":[{"lang_code":"en","lang":"Inglês","word":"tile"}],"pos":"noun","tags":null,"senses":[{"glosses":["peça de cerâmica esmaltada utilizada para cobrir uma superfície"],"examples":[{"text":"O piso escolhido foi uma cerâmica bem resistente, da Portobello, que não risca com qualquer queda de talher, e uma parede de azulejo, fácil de limpar e manter a cozinha higienizada.","bold_text_offsets":[[125,132]],"ref":"notícia do jornal O Estado de S. Paulo de 06 de março de 2010"}]}],"related":[],"synonyms":[{"word":"ladrilho"}]},"azul-marinho":{"id":"3b193c92-52b4-4d9f-acb5-430c05f36022","word":"azul-marinho","trans":[{"lang_code":"en","lang":"Inglês","word":"navy-blue"}],"pos":"adj","tags":["common"],"senses":[{"glosses":["de cor azul-marinho"]}],"related":[],"synonyms":[]},"azul-escuro":{"id":"5faa2f80-9f79-4661-82e7-15e0078f7b6b","word":"azul-escuro","trans":[{"lang_code":"en","lang":"Inglês","word":"dark blue"}],"pos":"adj","tags":null,"senses":[{"gl