licus rupestris)"], "categories": ["Botânica (Português)"], "topics": ["botany"]}], "related": [], "synonyms": [{"word": "bacelos"}, {"word": "bifes"}, {"word": "cachilro"}, {"word": "chapéus-de-parede"}, {"word": "cauxilhos"}, {"word": "chapéu-dos-telhados"}, {"word": "cochilros"}, {"word": "conchelos"}, {"word": "copilas"}, {"word": "couxilgos"}, {"word": "orelha-de-monge"}, {"word": "sombreirinho-dos-telhados"}]}, "umbro": {"id": "9d4d3a46-4ce0-48f9-89f4-2515b62c225e", "word": "umbro", "trans": [{"lang_code": "en", "lang": "Inglês", "word": "Umbrian", "sense": "habitante da Úmbria", "sense_index": 1}], "pos": "noun", "tags": null, "senses": [{"glosses": ["habitante ou natural da Úmbria"], "tags": ["demonym"], "categories": ["Gentílico (Português)"]}, {"glosses": ["raça canina usada para caçar veados"], "raw_tags": ["Cinologia"], "categories": ["Cinologia (Português)"]}, {"glosses": ["o dialeto falado na antiga região italiana da Úmbria, entre o rio Tibre e o mar Adriático"], "categories": ["Língua (Português)"], "topics": ["linguistics"]}], "related": [], "synonyms": []}, "umbaúba": {"id": "8beeb4b3-15a5-4312-80e5-ab51713731ad", "word": "umbaúba", "trans": [{"lang_code": "en", "lang": "Inglês", "word": "cecropia"}, {"lang_code": "en", "lang": "Inglês", "word": "trumpet tree"}], "pos": "noun", "tags": ["feminine"], "senses": [{"glosses": ["designação comum a várias espécies de árvores do gênero Cecropia (família Urticaceae) que têm altura média de 5 a 15 metros de altura, podendo algumas atingirem até 40 metros, nativa das regiões neotropicais das Américas Central e do Sul, tendo como uma característica da maioria de suas espécies a relação simbiótica chamada mirmecofilia com formigas do gênero Azteca (48 das 61 espécies), com folhas de uso medicinal e alimento predileto do bicho preguiça"], "raw_tags": ["Árvore"], "categories": ["Árvore (Português)"], "examples": [{"text": "As variações do nome desta árvore são sutis (embaúva, imbaúba, umbaúba, umbaubeira, ambaíba e umbaúba-do-brejo). O mais diferente deles é “árvore-da-preguiça”, por ser esta espécie a preferida, por exemplo, da preguiça-de-coleira, que consome avidamente as suas folhas tenras. Já os pássaros a procuram por causa dos frutos.", "bold_text_offsets": [[63, 70], [94, 101]]}]}, {"glosses": ["nome comum da espécie Cecropia peltata, atinge em média 20 metros, com uso medicinal diurético e frutos comestíveis e que, fora de seu habitat, tornou-se a vigésima entre a 100 espécies exóticas invasoras mais daninhas do mundo da União Internacional para a Conservação da Natureza (UICN)"], "raw_tags": ["Árvore"], "categories": ["Árvore (Português)"]}], "related": [], "synonyms": [{"word": "árvore-da-preguiça"}, {"word": "pau-de-preguiça"}, {"word": "pau-trombeta"}, {"word": "umbaubeira"}, {"word": "caxeta"}, {"word": "pau-de-lixa"}, {"word": "toré"}, {"word": "torém"}, {"word": "ambaíba"}, {"word": "ambaúba"}, {"word": "embaúba"}, {"word": "embaúva"}, {"word": "imbaúba"}, {"word": "imbaúva"}]}, "umbilical": {"id": "b7eb48c3-3534-480f-80bb-6b3d13ded9a0", "word": "umbilical", "trans": [{"lang_code": "en", "lang": "Inglês", "word": "umbilical"}], "pos": "adj", "tags": null, "senses": [{"glosses": ["do umbigo ou com ele relacionado"]}], "related": [], "synonyms": []}, "umbilicalmente": {"id": "4dbc925f-afc5-4915-a5fb-02d3924853a5", "word": "umbilicalmente", "trans": [{"lang_code": "en", "lang": "Inglês", "word": "umbilically"}], "pos": "adv", "tags": null, "senses": [{"glosses": ["de modo umbilical"], "examples": [{"text": "«A identidade cultural de um povo está umbilicalmente presa à sua língua materna.»"}]}], "related": [], "synonyms": []}}