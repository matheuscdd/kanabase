rário e pelo qual tenha passado (situações como blitzes, acidente, obstáculo, etc.)"],"tags":["Brazil","colloquial"],"categories":["Coloquialismo (Português)","Português brasileiro"]}],"related":[],"synonyms":[{"word":"nictação"},{"word":"pestanejo"},{"word":"piscadela"},{"word":";)","raw_tags":["multilíngue"]}]},"pisgar-se":{"id":"3d868c8e-a297-4bb5-8333-e7e5736d6edd","word":"pisgar-se","pos":"verb","senses":[{"id":"678f7a1f-e81d-4cd4-a03a-703761ca27b1","glosses":["O mesmo que _pirar-se_: «_...que o fidalgo fizera bem em se pisgar com o doutor..._» Camillo, _Brasileira_, 78."]}],"translations":[{"word":"absquatulate","lang":"Inglês","code":"en","lang_code":"en","sense":"to leave quickly or in a hurry; to take oneself off; to decamp; to depart","pos":"verb","tags":null}]},"pista de pouso":{"id":"8722aa84-1e37-4986-b5be-3b8b6657a9b2","word":"pista de pouso","pos":"noun","senses":[{"id":"48fc49dc-7b88-4ce8-8480-51c902874796","glosses":["Um aeroporto sem instalações aeroportuárias normais"]}],"translations":[{"word":"airstrip","lang":"Inglês","code":"en","lang_code":"en","sense":"primitive aircraft landing field","pos":"noun","tags":null},{"word":"runway","lang":"Inglês","code":"en","lang_code":"en","sense":"(aviation) strip for airplanes to land on or take off from","pos":"noun","tags":null}]},"pistola de pressão":{"id":"e8c4394d-134b-433b-be2f-925952f9231a","word":"pistola de pressão","pos":null,"senses":[{"id":"541918c4-833f-41ec-b26b-42a2b2b17e0e","glosses":["pistola que impulsiona uma pellet"]}],"translations":[{"word":"air pistol","lang":"Inglês","code":"en","lang_code":"en","sense":"pistol that propels a pellet","pos":"noun","tags":null}]},"piscina de bolinhas":{"id":"a23aec84-db44-4396-9265-3f9de157c028","word":"piscina de bolinhas","pos":null,"senses":[{"id":"23f72975-7a41-469c-a634-991a61298110","glosses":["tipo de área de jogo"]}],"translations":[{"word":"ball pit","lang":"Inglês","code":"en","lang_code":"en","sense":"type of play area","pos":"noun","tags":n