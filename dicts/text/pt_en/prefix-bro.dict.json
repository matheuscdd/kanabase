e sua descoberta até aquela data"},{"text":"Agora, no entanto, um estudo feito por cientistas portugueses e britânicos provou que o brontossauro é realmente distinto do apatossauro, restabelecendo sua classificação como um gênero próprio e único.","bold_text_offsets":[[88,100]]},{"text":"O grupo com quadril de lagarto tinha dois ramos: o de herbívoros, como o brontossauro, e o de carnívoros, como o tiranossauro.","bold_text_offsets":[[73,85]]}]}],"related":[],"synonyms":[]},"bronze de alumínio":{"id":"aca75868-32f1-4977-bc5a-9c0898f061d3","word":"bronze de alumínio","pos":null,"senses":[{"id":"f246d74e-290a-4197-a2e9-02f4800d81aa","glosses":["liga de cobre com cerca de 5% a 10% de alumínio"]}],"translations":[{"word":"aluminium bronze","lang":"Inglês","code":"en","lang_code":"en","sense":"alloy of copper with about 5% to 10% aluminium","pos":"noun","tags":null}]},"broto de bambu":{"id":"619183c0-6ef1-496f-8738-751dc41d1124","word":"broto de bambu","pos":null,"senses":[{"id":"9415b35f-d3ce-45cf-a1e6-82c632f16288","glosses":["parte comestível de alguns tipos de bambu"]}],"translations":[{"word":"bamboo shoot","lang":"Inglês","code":"en","lang_code":"en","sense":"edible part of some bamboo types","pos":"noun","tags":null}]},"broto de feijão":{"id":"497d5b63-7f90-494c-af18-5ee7868176b3","word":"broto de feijão","pos":null,"senses":[{"id":"5b45561c-fdf4-4906-80c3-729ba50c9160","glosses":["um broto de feijão mung"]}],"translations":[{"word":"bean sprout","lang":"Inglês","code":"en","lang_code":"en","sense":"a sprout of the mung bean","pos":"noun","tags":null}]},"broca":{"id":"86dd934a-cd54-4a06-8dc3-db8adbbd6336","word":"broca","pos":"noun","senses":[{"id":"dee8212c-7b45-4758-b59a-4cb01b77020d","glosses":["ferramenta"]}],"translations":[{"word":"borer","lang":"Inglês","code":"en","lang_code":"en","sense":"tool","pos":"noun","tags":null}]},"broxar":{"id":"99cf1704-acfc-4eac-ab05-8394b67f9927","word":"broxar","pos":null,"senses":[{"id":"7ec61de8-d377-4b9e-ac35-3f3a10cd1316"