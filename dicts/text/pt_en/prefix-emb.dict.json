_text_offsets": [[132, 140]]}]}, {"glosses": ["cercado e preso com força"], "examples": [{"text": "Lendas e narrativas", "ref": ", Alexandre Herculano, , pag: 198"}, {"text": "A um aceno de D. Leonor, o donzel metteu a tocha no annel de ferro embebido na parede, d'onde a tinha tirado, e encaminhou-se para juncto da porta, onde ficou com os braços cruzados, olhos no chão, e immovel como uma estatua.", "bold_text_offsets": [[67, 75]]}]}, {"glosses": ["integrado"], "examples": [{"text": "O Panorama Volume 2", "ref": ", , pag: 202"}, {"text": "estar embebida no corpo do edificio", "bold_text_offsets": [[6, 14]]}]}, {"glosses": ["embutido"], "categories": ["Informática (Português)"], "topics": ["information-science"], "examples": [{"text": "Língua Portuguesa Na Era Digital", "ref": ", , pag: 27"}, {"text": "Cabe notar que um gerador automático de texto deste género não representa, em regra, uma aplicação individual, encontrando-se embebido numa aplicação mais vasta, como é o caso dos sistemas de informação hospitalares", "bold_text_offsets": [[126, 134]]}]}], "related": [], "synonyms": []}, "emboscada": {"id": "d2693975-15b3-4303-927c-3df97000d84e", "word": "emboscada", "trans": [{"lang_code": "en", "lang": "Inglês", "word": "ambuscade"}, {"lang_code": "en", "lang": "Inglês", "word": "ambush"}], "pos": "noun", "tags": ["feminine"], "senses": [{"glosses": ["ação de se esconder num local para atacar de surpresa"]}, {"glosses": ["ação que visa enganar"]}], "related": [], "synonyms": []}, "embuçar": {"id": "9f673f57-3e33-4304-acca-5f55773cfe52", "word": "embuçar", "trans": [{"lang_code": "en", "lang": "Inglês", "word": "disguise", "sense": "disfarçar"}, {"lang_code": "en", "lang": "Inglês", "word": "mum", "sense": "disfarçar"}, {"lang_code": "en", "lang": "Inglês", "word": "wrap up", "sense": "disfarçar"}], "pos": "verb", "tags": null, "senses": [{"glosses": ["disfarçar"]}], "related": [], "synonyms": []}, "embuçado": {"id": "ed6bff02-185d-42c2-92f8-f50ae7664e6a", "word": "e