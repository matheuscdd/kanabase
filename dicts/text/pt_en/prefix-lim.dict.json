":"adj","tags":["common","dual"],"senses":[{"glosses":["que se situa ou que vive nos limites de uma extensão, de uma região etc.; que tem limites comuns"],"examples":[{"text":"zona limítrofe","bold_text_offsets":[[5,14]]}]},{"glosses":["muito próximo; vizinho"],"tags":["figuratively"],"categories":["Figurado (Português)"],"examples":[{"text":"arrebatamentos limítrofes do êxtase místico","bold_text_offsets":[[15,25]]}]}],"related":[],"synonyms":[]},"limerência":{"id":"8e480177-2ddb-4197-866e-b1fff9e9852e","word":"limerência","trans":[{"lang_code":"en","lang":"Inglês","word":"limerence","sense_index":1}],"pos":"noun","tags":["feminine"],"senses":[{"glosses":["estado cognitivo e emocional involuntário que resulta de um desejo romântico por outra pessoa combinado por uma intensa, avassaladora e obsessiva necessidade de se ter o sentimento correspondido"],"examples":[{"text":"Descomplique, seja leve","ref":", Wanderley Oliveira, , Editora Dufaux, página: ?"},{"text":"No caso da limerência","bold_text_offsets":[[11,21]]},{"text":"Transforme seu parceiro na sua alma gêmea: Um guia prático para seu final feliz","ref":", Arielle Ford, , HarperCollins Brasil, página: ?"},{"text":"Tanto a limerência, quanto o amor ocorrem na parte do cérebro chamada insula.","bold_text_offsets":[[8,18]]},{"text":"Agora, tanto o sofrimento documentado e sistemático de quem sofre de \"limerência\"","bold_text_offsets":[[70,80]],"ref":"revista Galileu de 04 de outubro de 2016"}]}],"related":[],"synonyms":[{"word":"limerância","sense_index":1}]},"limerância":{"id":"3a90ab6c-37c2-4b7a-a380-b4f890fe43c3","word":"limerância","trans":[{"lang_code":"en","lang":"Inglês","word":"limerence","sense_index":1}],"pos":"noun","tags":["feminine"],"senses":[{"glosses":["estado cognitivo e emocional involuntário que resulta de um desejo romântico por outra pessoa combinado por uma intensa, avassaladora e obsessiva necessidade de se ter o sentimento correspondido"],"examples":[{"text":"Psicocronicando","ref":", Emílio Figueira, , Clube de Autores, página: 83"},{"text":"No campo dos sentimentos há também o Limerence (ou limerância), um estado cognitivo e emocional involuntário","bold_text_offsets":[[51,61]]},{"text":"O Animal Social","ref":", DAVID BROOKS, , Leya, páginsa: ?"},{"text":"Alcançar a limerância pode, por outro lado, originar uma avassaladora sensação de ascensão.","bold_text_offsets":[[11,21]]},{"text":"Já Não Há Canções de Amor","ref":", ANOUCHKA GROSE, , Leya, página: ?"},{"text":"Uau, há dois milénios que andamos por cá ignorando por completo o elefante que é a limerância!","bold_text_offsets":[[83,93]]}]}],"related":[],"synonyms":[{"word":"limerência","sense_index":1}]},"limerente":{"id":"2701508e-6383-49f0-a939-731cee2a91eb","word":"limerente","trans":[{"lang_code":"en","lang":"Inglês","word":"limerent","sense_index":1}],"pos":"adj","tags":["common","dual"],"senses":[{"glosses":["que diz respeito a limerância"]}],"related":[],"synonyms":[]},"limonada suíça":{"id":"744cc276-4ba0-4652-b964-b8f28e072863","word":"limonada suíça","trans":[{"lang_code":"en","lang":"Inglês","word":"Brazilian lemonade"}],"pos":"phrase","tags":["feminine","substantive"],"senses":[{"glosses":["um tipo de limonada feita com limão, cubos de gelo e às vezes leite condensado"]}],"related":[],"synonyms":[]},"limbo":{"id":"3ea429bf-5571-4478-bc70-d9f644d20584","word":"limbo","pos":"noun","senses":[{"id":"46d450de-32f5-4f16-8755-23bb07b1d670","glosses":["Extremidade; fímbria; rebôrdo. Parte livre das sépalas e pétalas. Lugar, em que, segundo a crença christan, estão as almas das crianças que morrem sem baptismo, e em que estavam as almas dos justos, fallecidos antes da vinda de Christo."]},{"id":"76c2c74f-3ae2-4f72-8a61-7c190182b789","glosses":["Risca que, ao jôgo da péla, se faz numa parede, e na qual se não perde nem se ganha, se lhe bate a pela."]}],"translations":[{"word":"blade","lang":"Inglês","code":"en","lang_code":"en","sense":"the flat part of a leaf or petal","pos":"noun","tags":n