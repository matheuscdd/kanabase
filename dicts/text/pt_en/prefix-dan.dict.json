 etc."],"raw_tags":["Por extensão"],"examples":[{"text":"Saward revelou que a aposentadoria do mexicano deve ser anunciada após o GP do México, deixando uma vaga disponível na Red Bull ao lado de Max Verstappen. É nesse momento que a ‘dança das cadeiras’ pode acabar acontecendo.","bold_text_offsets":[[178,196]]},{"text":"Dança das cadeiras para tirar Bonner do JN envolve até Ticiane Pinheiro na Globo","bold_text_offsets":[[0,18]]},{"text":"Mais que a dança das cadeiras entre os modismos de cada hora, mostram que, por esgotamento de fórmula, pela queda de auto-estima forçada pela chegada forte dos mais novos ou pela decadência natural e inevitável, o artista perdera muito de sua fibra àquela altura.","bold_text_offsets":[[11,29]]}]}],"related":[],"synonyms":[]},"danificar":{"id":"c0a69130-bd51-4f12-b76d-ad7d9951c2d8","word":"danificar","pos":"verb","senses":[{"id":"96b56607-71b9-4312-ab7a-d828a899124e","glosses":["Causar dano a: _a chuva danificou a seara_."]}],"translations":[{"word":"bang up","lang":"Inglês","code":"en","lang_code":"en","sense":"to damage","pos":"verb","tags":null},{"word":"damage","lang":"Inglês","code":"en","lang_code":"en","sense":"to make something less intact or even destroy it; to harm or cause destruction","pos":"verb","tags":null}]},"dança do ventre":{"id":"0690674a-23e5-42ac-97eb-1e4a9d4dc76b","word":"dança do ventre","pos":"noun","senses":[{"id":"73d8cbb5-80d5-4451-959c-0f83cd29efd8","glosses":["forma de dança"]}],"translations":[{"word":"belly dance","lang":"Inglês","code":"en","lang_code":"en","sense":"form of dance","pos":"noun","tags":null}]},"dança oriental":{"id":"f1c682bf-a593-4194-b326-10913d2fa569","word":"dança oriental","pos":null,"senses":[{"id":"b33a5471-15cd-489f-8daa-cf02c8a4220f","glosses":["forma de dança"]}],"translations":[{"word":"belly dance","lang":"Inglês","code":"en","lang_code":"en","sense":"form of dance","pos":"noun","tags":null},{"word":"oriental dance","lang":"Inglês","code":"en","lang_code":"en","sense":"form