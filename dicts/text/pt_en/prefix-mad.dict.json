usíadas_, (X, 137), porque se lêssemos _Madagascár_, o respectivo verso ficaria errado ou, pelo menos, defeituosissimo. Mas, dado que esta razão seja discutível, temos que o voc. é malaio e, nesta língua, não há, em regra, palavras oxýtonas; além de que, se a palavra fôsse realmente oxýtona ou aguda, os antigos dobrariam a última vogal, como fizeram em _caa_, _see_, _atee_ etc., por _cá_, _sé_, _até_, etc., para preencher de alguma fórma a falta de accentos."]}],"translations":[{"word":"madagascar","lang":"Inglês","code":"en","lang_code":"en","sense":"country in Southern Africa","pos":"name","tags":null}]},"madhya pradesh":{"id":"ddbb1734-2635-4e7e-a44e-bde84ae3834c","word":"madhya pradesh","pos":null,"senses":[{"id":"77d8cdf6-399b-4de2-8437-73e1546394b3","glosses":["Estado na Índia central"]}],"translations":[{"word":"madhya pradesh","lang":"Inglês","code":"en","lang_code":"en","sense":"state in central India","pos":"name","tags":null}]},"madrid":{"id":"546964c5-cbd9-4323-bb85-3a91075ec86f","word":"madrid","pos":"noun","senses":[{"id":"c9c11ed4-3073-4fec-af61-9df63bb28f7c","glosses":["capital da Espanha"]}],"translations":[{"word":"madrid","lang":"Inglês","code":"en","lang_code":"en","sense":"capital of Spain","pos":"name","tags":null}]},"madri":{"id":"a82ae7d3-27f5-4ae2-b67f-dfabc9800bfb","word":"madri","pos":"noun","senses":[{"id":"2ca543c2-2aa5-4907-b574-4c196a98642f","glosses":["capital da Espanha"]}],"translations":[{"word":"madrid","lang":"Inglês","code":"en","lang_code":"en","sense":"capital of Spain","pos":"name","tags":null}]},"madride":{"id":"8481b816-b872-4097-beb4-5e174aea283e","word":"madride","pos":null,"senses":[{"id":"4710f70c-b43a-45a8-ba80-afcf12bb1ba9","glosses":["capital da Espanha"]}],"translations":[{"word":"madrid","lang":"Inglês","code":"en","lang_code":"en","sense":"capital of Spain","pos":"name","tags":null}]},"madalena":{"id":"aee505a3-dd91-40c4-8357-3ba3eac4013e","word":"madalena","pos":"noun","senses":[{"id":"d5c30778-e806-41ff-8f95-0da