ismo (Português)","Figurado (Português)"],"examples":[{"text":"Dá três pontos nos teus lábios, / Se vires, lá no horizonte, / Carrancudo mastodonte, / Na ponta de uma navalha, / Vender cigarros de palha, / Molhados na água da fonte!...","bold_text_offsets":[[74,84]],"ref":"Bernardo Guimarães, Disparates Rimados"}]},{"glosses":["algo de grandes dimensões"],"tags":["colloquial","figuratively"],"categories":["Coloquialismo (Português)","Figurado (Português)"],"examples":[{"text":"A Rússia fria, - Mastodonte eterno / Cuja cabeça sobre os gelos dorme","bold_text_offsets":[[17,27]],"ref":"Fagundes Varela, Ao Brasil"}]}],"related":[],"synonyms":[{"word":"brucutu"},{"word":"brutamontes"},{"word":"ferrabrás"}]},"mascote":{"id":"d09a45b0-45a4-44a2-982e-657fad150295","word":"mascote","trans":[{"lang_code":"en","lang":"Inglês","word":"mascot","sense":"animal, pessoa ou objeto animado que é escolhido como representante visual ou identificador de uma marca, uma empresa ou evento","sense_index":1}],"pos":"noun","tags":["common","dual"],"senses":[{"glosses":["animal, pessoa ou objeto animado que é escolhido como representante visual ou identificador de uma marca, uma empresa ou evento"],"examples":[{"text":"O compacto GC2 foi desenhado para remeter a um urso panda, mamífero que habita as montanhas chinesas e serviu de mascote nos Jogos Olímpicos de 2008.","bold_text_offsets":[[113,120]],"ref":"notícia do jornal O Estado de S. Paulo de 04 de novembro de 2014"}]},{"glosses":["animal objeto do afeto de uma ou de um grupo de pessoas"],"tags":["Brazil","familiar"],"categories":["Coloquialismo (Português)","Português brasileiro"]}],"related":[],"synonyms":[]},"mascato":{"id":"78b20d82-6db8-413d-8bda-df072ba40b7b","word":"mascato","trans":[{"lang_code":"en","lang":"Inglês","word":"gannet"}],"pos":"noun","tags":["masculine"],"senses":[{"glosses":["ave marinha de quase um metro de envergadura, de cor branca com as pontas das asas pretas, (Morus bassanus)"],"categories":["Ave (Português)"],"