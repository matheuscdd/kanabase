o; volumoso"]},{"glosses":["muito maior do que o normal, em grande quantidade ou proporção"]},{"glosses":["referente a ou próprio de povo, de massas"]}],"related":[],"synonyms":[{"word":"maciço"}]},"massa corrida":{"id":"04d75836-5b63-41d5-a32b-632069b59636","word":"massa corrida","trans":[{"lang_code":"en","lang":"Inglês","word":"spackling paste"}],"pos":"phrase","tags":["substantive"],"senses":[{"glosses":["espécie de resina, de origem natural ou sintética, usada em pequenos reparos e acabamentos em paredes e afins"],"examples":[{"text":"Aumentaram as despesas com ajudante especializado (2,84%), servente (2,62%), pedreiro (2,76%), engenheiro (3,25%) e carpinteiro de forma e telhado (2,27%). Na direção oposta, ficaram mais baratos cimento portland comum (-0,29%), perna 3x3/estronca de 3ª (-0,66%), tijolo e telha cerâmica (-0,19%), metais para instalações hidráulicas (-0,14%) e massa corrida para parede PVA (-0,36%).","bold_text_offsets":[[345,358]],"ref":"notícia do jornal O Estado de S. Paulo de 19 de junho de 2012"}]}],"related":[],"synonyms":[]},"masoquismo":{"id":"967d8cbd-086a-46c9-acef-10252ab93600","word":"masoquismo","trans":[{"lang_code":"en","lang":"Inglês","word":"masochism"}],"pos":"noun","tags":["masculine"],"senses":[{"glosses":["perversão sexual que faz procurar o prazer na dor física e nas humilhações"]},{"glosses":["atitude de uma pessoa que retira prazer ou parece gostar do seu sofrimento ou humilhação"],"raw_tags":["Por extensão"]}],"related":[],"synonyms":[]},"mastalgia":{"id":"a7a7e577-3229-4e99-9dd4-954a2b46cea7","word":"mastalgia","trans":[{"lang_code":"en","lang":"Inglês","word":"mastalgia"}],"pos":"noun","tags":null,"senses":[{"glosses":["dor nas mamas"],"examples":[{"text":"O tratamento, entretanto, pode provocar mastalgia (dor nas mamas), retenção de líquidos e sangramento genital, sintomas incômodos que dificultam a adesão das pacientes.","bold_text_offsets":[[40,49]],"ref":"notícia do jornal O Estado de S. Paulo de 06 de maio de 2004"}]