{"peixe":{"id":"f3c49390-2cdf-486a-9ad9-d14e43f1d2f6","word":"peixe","trans":[{"lang_code":"en","lang":"Inglês","word":"fish","sense":"animal aquático","sense_index":1}],"pos":"noun","tags":["masculine"],"senses":[{"glosses":["animal aquático pecilotérmico, dotado de corpo fusiforme, nadadeiras e guelras"],"examples":[{"text":"É irrefutável a tese de que uma pessoa faminta precisa, primeiro, comer o peixe para, depois, aprender a arte de pescar.","bold_text_offsets":[[74,79]],"ref":"notícia do jornal O Estado de S. Paulo de 03 de fevereiro de 2008"}]},{"glosses":["assunto"],"examples":[{"text":"Ela disse que não tem nada que ver com o peixe.","bold_text_offsets":[[41,46]]}]},{"glosses":["santista"],"raw_tags":["Futebol"],"categories":["Desporto (Português)","Futebol (Português)"],"topics":["sports"]}],"related":[],"synonyms":[]},"peido":{"id":"b9fb8ea0-19b7-44a8-814e-a3b2d7afd946","word":"peido","trans":[{"lang_code":"en","lang":"Inglês","word":"fart"}],"pos":"noun","tags":["masculine"],"senses":[{"glosses":["gases intestinais, mais ou menos ruidosos, expelidos pelo ânus; flato"],"tags":["informal"],"categories":["Coloquialismo (Português)"]}],"related":[],"synonyms":[{"word":"borra-cuecas"},{"word":"bufa"},{"word":"espirro"},{"word":"estoura-tripas"},{"word":"fanfarra"},{"word":"farpola"},{"word":"pufute"},{"word":"pum"},{"word":"traque"},{"word":"ventosa"}]},"peixe-espada":{"id":"d9b3baa6-7112-4b3f-af15-b8935ef9b42b","word":"peixe-espada","trans":[{"lang_code":"en","lang":"Inglês","word":"swordfish","sense":"X. gladius","sense_index":1},{"lang_code":"en","lang":"Inglês","word":"beltfish","sense":"L. caudatus","sense_index":2},{"lang_code":"en","lang":"Inglês","word":"frostfish","sense":"L. caudatus","sense_index":2},{"lang_code":"en","lang":"Inglês","word":"silver scabbardfish","sense":"L. caudatus","sense_index":2},{"lang_code":"en","lang":"Inglês","word":"banded knifefish","sense":"G. carapo","sense_index":4}],"pos":"noun","tags":["masculine"],"senses":[{"glosses":["designação comum do grande peixe ósseo predador (Xiphias gladius, única espécie de seu gênero), encontrado em mares temperados e tropicais de todo o mundo, vive em mar aberto, raramente se aproxima da costa e se alimenta de outros peixes e cefalópodes, possui o rostro em forma de espada, que lhe dá o nome, pode atingir um terço do comprimento do corpo em peixes adultos, possui um corpo fusiforme com seção transversal altamente oval e, muito apreciado na culinária, o maior espécime capturado media 4,55 metros e pesava 650 kg, sendo que os juvenis diferem dos adultos em vários aspectos, como possuir uma mandíbula inferior longa e com dentes finos, única barbatana dorsal contínua e corpo escamoso, enquanto os adultos não têm dentes nem escamas, e duas nadadeiras costais bem separadas"],"categories":["Peixe (Português)"],"topics":["ichthyology"],"examples":[{"text":"Xiphias","ref":"Nota: O nome científico do gênero () vem do grego ξίφος (\"xiphos\"), que significa espada, e o epíteto específico latino gladius refere-se à espada curta romana (\"gládio\"); embora com alguma semelhança física, não tem parentesco como o marlim-azul-do-atlântico"},{"text":"Uma surfista italiana morreu após ser atingida por um peixe-espada em um acidente raro na Indonésia nesta sexta-feira (18).","bold_text_offsets":[[54,66]]}]},{"glosses":["espécie de peixe (Lepidopus caudatus) comum na costa leste do Atlântico (desde França à África do Sul), sul do Índico e Pacífico (costas australianas e neozelandesas), bentopelágica durante o dia quando habita o leito oceânico e migrando para a zona pelágica à noite, gregária e vivendo em cardumes, caracterizada por ter corpo longilíneo, barbatana dorsal contínua, dentes pontiagudos e grandes, coloração uniformemente prateada e podendo atingir até 1,35 m de comprimento"],"tags":["Portugal"],"categories":["Peixe (Português)","Português lusitano"],"topics":["ichthyology"]},{"glosses":["ação de golpear com uma espada"],"tags":["Portugal"],"raw_tags":["Gíria"],"categories":["Gíria (Português)","Português lusitano"]},{"glosses":["peixe teleósteo caraciforme da família dos gimnotídeos (Gymnotus carapo), comum em todo o litoral brasileiro até a foz do Rio da Prata, de cor parda ou cinza-amarelada com faixas escuras, preferencialmente noturno, alimenta-se de pequenos vermes, lodo e plâncton, e é capaz de produzir pequenas descargas elétricas"],"tags":["Brazil"],"categories":["Peixe (Português)","Português brasileiro"],"topics":["ichthyology"]}],"related":[],"synonyms":[{"word":"espadarte"},{"word":"peixe-espada-branco"},{"word":"espadeirada"},{"word":"carapó"},{"word":"ituí"},{"word":"ituipinima"},{"word":"sabão"},{"word":"sarapó"},{"word":"sarapó-tuvira"},{"word":"tira-faca"},{"word":"tuvira"}]},"peidar":{"id":"ae975ed0-0384-40bb-9e13-8929361f33df","word":"peidar","trans":[{"lang_code":"en","lang":"Inglês","word":"fart"}],"pos":"verb","tags":null,"senses":[{"glosses":["soltar gases pelo ânus"],"tags":["informal"],"categories":["Coloquialismo (Português)"]},{"glosses":["deixar de fazer algo por medo"],"raw_tags":["gíria"],"categories":["Gíria (Português)"]}],"related":[],"synonyms":[]},"peito":{"id":"eca0c4d4-da9e-4e42-b927-087821fc87ee","word":"peito","trans":[{"lang_code":"en","lang":"Inglês","word":"bosom","sense":"anatomia","sense_index":1},{"lang_code":"en","lang":"Inglês","word":"chest","sense":"anatomia","sense_index":1}],"pos":"noun","tags":["masculine"],"senses":[{"glosses":["parte do corpo humano onde ficam as glândulas mamárias, maior no corpo feminino devido ao desenvolvimento das referidas glândulas"]},{"glosses":["seio de mulher"],"examples":[{"text":"Cicciolina tem peitos enormes.","bold_text_offsets":[[15,21]]}]},{"glosses":["tipo de corte de carne bovina"]},{"glosses":["coragem, destemor"],"tags":["figuratively"],"categories":["Figurado (Português)"],"examples":[{"text":"É um homem de muito peito.","bold_text_offsets":[[20,25]]}]}],"related":[],"synonyms":[{"word":"mama"},{"word":"seio"}]},"peixeiro":{