start":322.864,"end":322.925},{"word":"eixo","start":323.005,"end":323.307},{"word":"onde","start":323.428,"end":323.589},{"word":"o","start":323.629,"end":323.649},{"word":"foco","start":323.83,"end":324.092},{"word":"de","start":324.132,"end":324.213},{"word":"Jesus","start":324.293,"end":324.696},{"word":"muda","start":324.816,"end":325.098},{"word":"drasticamente","start":325.138,"end":325.42}]},{"start":326.32,"end":328.22,"text":"Muda daquele ministério público, né?","words":[{"word":"Muda","start":326.32,"end":326.724},{"word":"daquele","start":326.765,"end":327.027},{"word":"ministério","start":327.068,"end":327.492},{"word":"público","start":327.614,"end":328.018},{"word":"né","start":328.058,"end":328.22}]},{"start":328.422,"end":330.12,"text":"De curar as multidões na Galileia.","words":[{"word":"De","start":328.422,"end":328.483},{"word":"curar","start":328.584,"end":328.867},{"word":"as","start":328.907,"end":329.008},{"word":"multidões","start":329.11,"end":329.615},{"word":"na","start":329.655,"end":329.716},{"word":"Galileia","start":329.756,"end":330.12}]},{"start":330.28,"end":331.686,"text":"Isso, aham.","words":[{"word":"Isso","start":330.28,"end":330.963},{"word":"aham","start":331.244,"end":331.686}]},{"start":332.188,"end":339.48,"text":"Muda disso para uma instrução privada, bem mais intensa e quase secreta mesmo com os doze discípulos.","words":[{"word":"Muda","start":332.188,"end":332.47},{"word":"disso","start":332.61,"end":333.032},{"word":"para","start":333.153,"end":333.273},{"word":"uma","start":333.333,"end":333.434},{"word":"instrução","start":333.494,"end":333.996},{"word":"privada","start":334.077,"end":334.719},{"word":"bem","start":335.503,"end":335.663},{"word":"mais","start":335.704,"end":335.884},{"word":"intensa","start":335.945,"end":336.507},{"word":"e","start":336.547,"end":336.567},{"word":"quase","start":336.688,"end":336.969},{"word":"secreta","start":337.11,"end":337.712},{"word":"mesmo","start":337.773,"end":338.074},