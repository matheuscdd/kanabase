:"de","start":351.471,"end":351.532},{"word":"dados","start":351.592,"end":351.894},{"word":"teológico","start":351.954,"end":352.477},{"word":"Logos","start":352.558,"end":352.92}]},{"start":353.3,"end":359.8,"text":"e também os detalhes históricos e psicológicos que a Ellen White descreve no livro O Desejado de Todas as Nações.","words":[{"word":"e","start":353.3,"end":353.682},{"word":"também","start":353.743,"end":354.125},{"word":"os","start":354.447,"end":354.528},{"word":"detalhes","start":354.588,"end":354.99},{"word":"históricos","start":355.031,"end":355.655},{"word":"e","start":355.695,"end":355.715},{"word":"psicológicos","start":355.775,"end":356.56},{"word":"que","start":356.58,"end":356.661},{"word":"a","start":356.681,"end":356.761},{"word":"Ellen","start":356.781,"end":356.922},{"word":"White","start":357.023,"end":357.285},{"word":"descreve","start":357.325,"end":357.788},{"word":"no","start":357.828,"end":357.888},{"word":"livro","start":357.949,"end":358.23},{"word":"O","start":358.251,"end":358.412},{"word":"Desejado","start":358.472,"end":358.995},{"word":"de","start":359.035,"end":359.096},{"word":"Todas","start":359.156,"end":359.398},{"word":"as","start":359.458,"end":359.518},{"word":"Nações","start":359.559,"end":359.8}]},{"start":360.0,"end":362.8,"text":"E essas fontes trabalham muito bem juntas, viu?","words":[{"word":"E","start":360.0,"end":360.203},{"word":"essas","start":360.223,"end":360.528},{"word":"fontes","start":360.609,"end":360.913},{"word":"trabalham","start":360.994,"end":361.42},{"word":"muito","start":361.542,"end":361.826},{"word":"bem","start":361.907,"end":362.09},{"word":"juntas","start":362.192,"end":362.699},{"word":"viu","start":362.719,"end":362.8}]},{"start":362.98,"end":363.986,"text":"Nossa, sim!","words":[{"word":"Nossa","start":362.98,"end":363.382},{"word":"sim","start":363.744,"end":363.986}]},{"start":364.468,"end":370.24,"text":"E o nosso objetivo de mergulhar nesse material hoje é entender uma lógica inquebrável ali.","words":[{"word":"E","start":364.468,"end":364.649},{"word":"o","start":364.83,"end":364.85},{"word":"nosso","start":364.911,"end":365.132},{"word":"objetivo","start":365.152,"end":365.574},{"word":"de","start":365.635,"end":365.715},{"word":"mergulhar","start":365.796,"end":366.278},{"word":"nesse","start":366.318,"end":366.52},{"word":"material","start":366.56,"end":367.042},{"word":"hoje","start":367.083,"end":367.425},{"word":"é","start":367.445,"end":367.947},{"word":"entender","start":368.028,"end":368.49},{"word":"uma","start":368.551,"end":368.651},{"word":"lógica","start":368.732,"end":369.134},{"word":"inquebrável","start":369.335,"end":370.14},{"word":"ali","start":370.16,"end":370.24}]},{"start":370.22,"end":376.34,"text":"O motivo pelo qual a identidade de Jesus, ou seja, saber exatamente quem ele é","words":[{"word":"O","start":370.22,"end":371.005},{"word":"motivo","start":371.025,"end":371.468},{"word":"pelo","start":371.549,"end":371.71},{"word":"qual","start":371.77,"end":371.911},{"word":"a","start":371.931,"end":371.971},{"word":"identidade","start":372.012,"end":372.797},{"word":"de","start":372.837,"end":372.918},{"word":"Jesus","start":372.978,"end":373.602},{"word":"ou","start":374.126,"end":374.206},{"word":"seja","start":374.287,"end":374.508},{"word":"saber","start":374.609,"end":374.911},{"word":"exatamente","start":374.951,"end":375.595},{"word":"quem","start":375.756,"end":375.958},{"word":"ele","start":375.998,"end":376.199},{"word":"é","start":376.32,"end":376.34}]},{"start":376.32,"end":380.48,"text":"Precisava ser estabelecida sem nenhuma margem de dúvida","words":[{"word":"Precisava","start":376.32,"end":377.552},{"word":"ser","start":377.633,"end":377.734},{"word":"estabelecida","start":377.814,"end":378.582},{"word":"sem","start":378.885,"end":379.147},{"word":"nenhuma","start":379.228,"end":379.733},{"word":"margem","start":379.794,"end":380.117},{"word":"de","start":380.157,"end":380.218},{"word":"dúvida","start":380.298,"end":380.48}]},{"start":380.46,"end":385.62,"text":"Antes que o seu propósito, o motivo pelo qual ele ia morrer, fosse revelado","words":[{"word":"Antes","start":380.46,"end":381.569},{"word":"que","start":381.609,"end":381.69},{"word":"o","start":381.71,"end":381.73},{"word":"seu","start":381.77,"end":381.871},{"word":"propósito","start":381.952,"end":382.677},{"word":"o","start":383.08,"end":383.121},{"word":"motivo","start":383.161,"end":383.504},{"word":"pelo","start":383.544,"end":383.705},{"word":"qual","start":383.746,"end":383.867},{"word":"ele","start":383.887,"end":384.008},{"word":"ia","start":384.028,"end":384.068},{"word":"morrer","start":384.149,"end":384.572},{"word":"fosse","start":384.915,"end":385.136},{"word":"revelado","start":385.177,"end":385.62}]},{"start":385.6,"end":391.36,"text":"Porque olha, sem entender a identidade, o sacrifício seria só uma fatalidade, sabe?","words":[{"word":"Porque","start":385.6,"end":386.244},{"word":"olha","start":386.325,"end":386.526},{"word":"sem","start":386.607,"end":386.748},{"word":"entender","start":386.808,"end":387.332},{"word":"a","start":387.372,"end":387.413},{"word":"identidade","start":387.473,"end":388.299},{"word":"o","start":388.621,"end":388.661},{"word":"sacrifício","start":388.742,"end":389.346},{"word":"seria","start":389.427,"end":389.688},{"word":"só","start":389.89,"end":390.011},{"word":"uma","start":390.091,"end":390.192},{"word":"fatalidade","start":390.273,"end":391.239},{"word":"sabe","start":391.259,"end":391.36}]},{"start":391.58,"end":394.42,"text":"Mas antes da gente chegar nessa grande revelação","words":[{"word":"Mas","start":391.58,"end":392.31},{"word":"antes","start":392.371,"end":392.534},{"word":"da","start":392.574,"end":392.635},{"word":"gente","start":392.676,"end":392.858},{"word":"chegar","start":392.919,"end":393.223},{"word":"nessa","start":393.264,"end":393.467},{"word":"grande","start":393.548,"end":393.893},{"word":"revelação","start":393.974,"end":394.42}]},{"start":394.4,"end":400.1,"text":"A gente precisa olhar para a tensão que empurra Jesus para fora da Galileia logo no início","words":[{"word":"A","start":394.4,"end":395.024},{"word":"gente","start":395.125,"end":395.306},{"word":"precisa","start":395.387,"end":395.79},{"word":"olhar","start":395.85,"end":396.052},{"word":"para","start":396.132,"end":396.253},{"word":"a","start":396.273,"end":396.334},{"word":"tensão","start":396.354,"end":396.938},{"word":"que","start":397.018,"end":397.119},{"word":"empurra","start":397.159,"end":397.542},{"word":"Jesus","start":397.643,"end":398.046},{"word":"para","start":398.086,"end":398.227},{"word":"fora","start":398.469,"end":398.771},{"word":"da","start":398.811,"end":398.871},{"word":"Galileia","start":398.932,"end":399.435},{"word":"logo","start":399.556,"end":399.838},{"word":"no","start":399.899,"end":399.939},{"word":"início","start":399.959,"end":400.1}]},{"start":400.08,"end":404.18,"text":"O capítulo já começa com uma aliança muito improvável","words":[{"word":"O","start":400.08,"end":400.221},{"word":"capítulo","start":400.242,"end":401.494},{"word":"já","start":401.554,"end":401.635},{"word":"começa","start":401.716,"end":402.181},{"word":"com","start":402.241,"end":402.342},{"word":"uma","start":402.362,"end":402.443},{"word":"aliança","start":402.484,"end":402.968},{"word":"muito","start":403.312,"end":403.615},{"word":"improvável","start":403.655,"end":404.18}]},{"start":404.16,"end":408.02,"text":"Os fariseus e os saduceus se unem para testar Jesus","words":[{"word":"Os","start":404.16,"end":404.847},{"word":"fariseus","start":404.888,"end":405.595},{"word":"e","start":405.757,"end":405.817},{"word":"os","start":405.858,"end":405.959},{"word":"saduceus","start":405.999,"end":406.666},{"word":"se","start":406.848,"end":406.949},{"word":"unem","start":407.07,"end":407.313},{"word":"para","start":407.394,"end":407.555},{"word":"testar","start":407.576,"end":407.899},{"word":"Jesus","start":407.919,"end":408.02}]},{"start":408.0,"end":411.3,"text":"Eles chegam exigindo um sinal vindo do céu","words":[{"word":"Eles","start":408.0,"end":409.154},{"word":"chegam","start":409.276,"end":409.559},{"word":"exigindo","start":409.64,"end":410.146},{"word":"um","start":410.207,"end":410.268},{"word":"sinal","start":410.369,"end":410.673},{"word":"vindo","start":410.774,"end":410.976},{"word":"do","start":411.017,"end":411.118},{"word":"céu","start":411.24,"end":411.3}]},{"start":411.28,"end":413.22,"text":"E aqui acho que vale uma pausa","words":[{"word":"E","start":411.28,"end":411.77},{"word":"aqui","start":411.893,"end":412.138},{"word":"acho","start":412.26,"end":412.383},{"word":"que","start":412.403,"end":412.485},{"word":"vale","start":412.526,"end":412.689},{"word":"uma","start":412.73,"end":412.832},{"word":"pausa","start":412.996,"end":413.22}]},{"start":413.2,"end":416.86,"text":"Porque para quem não é especialista em história antiga e está acompanhando a gente","words":[{"word":"Porque","start":413.2,"end":413.544},{"word":"para","start":413.584,"end":413.706},{"word":"quem","start":413.807,"end":413.989},{"word":"não","start":414.07,"end":414.191},{"word":"é","start":414.272,"end":414.312},{"word":"especialista","start":414.373,"end":414.899},{"word":"em","start":414.919,"end":414.98},{"word":"história","start":415.02,"end":415.323},{"word":"antiga","start":415.384,"end":415.849},{"word":"e","start":415.869,"end":415.89},{"word":"está","start":415.91,"end":416.132},{"word":"acompanhando","start":416.152,"end":416.658},{"word":"a","start":416.698,"end":416.739},{"word":"gente","start":416.759,"end":416.86}]},{"start":416.84,"end":421.32,"text":"Pode parecer só um grupo de líderes religiosos fazendo perguntas normais","words":[{"word":"Pode","start":416.84,"end":417.768},{"word":"parecer","start":417.849,"end":418.192},{"word":"só","start":418.293,"end":418.454},{"word":"um","start":418.777,"end":418.818},{"word":"grupo","start":418.878,"end":419.1},{"word":"de","start":419.161,"end":419.242},{"word":"líderes","start":419.302,"end":419.585},{"word":"religiosos","start":419.645,"end":420.17},{"word":"fazendo","start":420.23,"end":420.513},{"word":"perguntas","start":420.614,"end":420.997},{"word":"normais","start":421.038,"end":421.32}]},{"start":421.3,"end":424.22,"text":"Mas esses dois grupos se odiavam, certo?","words":[{"word":"Mas","start":421.3,"end":422.273},{"word":"esses","start":422.334,"end":422.537},{"word":"dois","start":422.598,"end":422.78},{"word":"grupos","start":422.862,"end":423.166},{"word":"se","start":423.287,"end":423.389},{"word":"odiavam","start":423.409,"end":424.078},{"word":"certo","start":424.099,"end":424.22}]},{"start":424.4,"end":426.92,"text":"Qual era a dinâmica real entre eles ali?","words":[{"word":"Qual","start":424.4,"end":425.071},{"word":"era","start":425.152,"end":425.233},{"word":"a","start":425.274,"end":425.294},{"word":"dinâmica","start":425.376,"end":425.904},{"word":"real","start":426.006,"end":426.29},{"word":"entre","start":426.351,"end":426.554},{"word":"eles","start":426.656,"end":426.819},{"word":"ali","start":426.839,"end":426.92}]},{"start":427.1,"end":429.46,"text":"Nossa, é fundamental entender isso.","words":[{"word":"Nossa","start":427.1,"end":427.69},{"word":"é","start":427.751,"end":427.792},{"word":"fundamental","start":427.873,"end":428.707},{"word":"entender","start":428.87,"end":429.318},{"word":"isso","start":429.359,"end":429.46}]},{"start":429.92,"end":433.14,"text":"Eles eram inimigos mortais em termos ideológicos.","words":[{"word":"Eles","start":429.92,"end":430.426},{"word":"eram","start":430.487,"end":430.629},{"word":"inimigos","start":430.71,"end":431.257},{"word":"mortais","start":431.338,"end":431.885},{"word":"em","start":431.925,"end":432.006},{"word":"termos","start":432.087,"end":432.452},{"word":"ideológicos","start":432.472,"end":433.14}]},{"start":433.24,"end":437.4,"text":"Os fariseus eram os tradicionalistas estritos, sabe?","words":[{"word":"Os","start":433.24,"end":433.805},{"word":"fariseus","start":433.846,"end":434.613},{"word":"eram","start":434.734,"end":434.916},{"word":"os","start":434.977,"end":435.098},{"word":"tradicionalistas","start":435.219,"end":436.249},{"word":"estritos","start":436.33,"end":437.279},{"word":"sabe","start":437.299,"end":437.4}]},{"start":437.4,"end":442.2,"text":"Eles eram obcecados por cada detalhezinho da lei e pelas tradições orais.","words":[{"word":"Eles","start":437.4,"end":437.904},{"word":"eram","start":437.965,"end":438.146},{"word":"obcecados","start":438.166,"end":438.872},{"word":"por","start":438.933,"end":439.034},{"word":"cada","start":439.114,"end":439.336},{"word":"detalhezinho","start":439.397,"end":440.062},{"word":"da","start":440.103,"end":440.183},{"word":"lei","start":440.264,"end":440.607},{"word":"e","start":441.01,"end":441.051},{"word":"pelas","start":441.111,"end":441.333},{"word":"tradições","start":441.393,"end":441.898},{"word":"orais","start":441.958,"end":442.2}]},{"start":442.54,"end":444.201,"text":"Aham, os caras das regras.","words":[{"word":"Aham","start":442.54,"end":443.012},{"word":"os","start":443.298,"end":443.401},{"word":"caras","start":443.463,"end":443.708},{"word":"das","start":443.75,"end":443.893},{"word":"regras","start":443.954,"end":444.201}]},{"start":444.36,"end":444.925,"text":"Isso.","words":[{"word":"Isso","start":444.36,"end":444.925}]},{"start":445.046,"end":448.62,"text":"Já os saduceus eram a elite, a parte aristocrática e política.","words":[{"word":"Já","start":445.046,"end":445.228},{"word":"os","start":445.37,"end":445.45},{"word":"saduceus","start":445.531,"end":446.096},{"word":"eram","start":446.177,"end":446.339},{"word":"a","start":446.419,"end":446.46},{"word":"elite","start":446.52,"end":446.985},{"word":"a","start":447.025,"end":447.045},{"word":"parte","start":447.126,"end":447.51},{"word":"aristocrática","start":447.611,"end":448.378},{"word":"e","start":448.398,"end":448.418},{"word":"política","start":448.438,"end":448.62}]},{"start":448.88,"end":454.28,"text":"Bem mais pragmáticos, super amigáveis com o Império Romano e, pasmem,","words":[{"word":"Bem","start":448.88,"end":449.605},{"word":"mais","start":449.646,"end":449.867},{"word":"pragmáticos","start":449.948,"end":450.835},{"word":"super","start":451.399,"end":451.701},{"word":"amigáveis","start":451.741,"end":452.326},{"word":"com","start":452.386,"end":452.507},{"word":"o","start":452.527,"end":452.547},{"word":"Império","start":452.608,"end":452.87},{"word":"Romano","start":452.95,"end":453.474},{"word":"e","start":453.696,"end":453.776},{"word":"pasmem","start":453.938,"end":454.28}]},{"start":454.4,"end":458.74,"text":"Eles sequer acreditavam na ressurreição ou na existência de anjos","words":[{"word":"Eles","start":454.4,"end":454.945},{"word":"sequer","start":455.046,"end":455.47},{"word":"acreditavam","start":455.611,"end":456.277},{"word":"na","start":456.338,"end":456.419},{"word":"ressurreição","start":456.479,"end":457.206},{"word":"ou","start":457.388,"end":457.489},{"word":"na","start":457.509,"end":457.59},{"word":"existência","start":457.63,"end":458.215},{"word":"de","start":458.276,"end":458.357},{"word":"anjos","start":458.478,"end":458.74}]},{"start":458.72,"end":462.22,"text":"Caramba, ou seja, ideologias totalmente opostas","words":[{"word":"Caramba","start":458.72,"end":459.752},{"word":"ou","start":459.772,"end":459.813},{"word":"seja","start":459.833,"end":460.136},{"word":"ideologias","start":460.561,"end":461.269},{"word":"totalmente","start":461.35,"end":461.755},{"word":"opostas","start":461.816,"end":462.22}]},{"start":462.2,"end":463.041,"text":"Totalmente","words":[{"word":"Totalmente","start":462.2,"end":463.041}]},{"start":463.02,"end":467.4,"text":"A única coisa no mundo capaz de fazer esses dois grupos rivais","words":[{"word":"A","start":463.02,"end":463.706},{"word":"única","start":463.726,"end":463.989},{"word":"coisa","start":464.09,"end":464.413},{"word":"no","start":464.594,"end":464.756},{"word":"mundo","start":464.837,"end":465.079},{"word":"capaz","start":465.16,"end":465.563},{"word":"de","start":465.604,"end":465.664},{"word":"fazer","start":465.765,"end":466.088},{"word":"esses","start":466.129,"end":466.33},{"word":"dois","start":466.391,"end":466.633},{"word":"grupos","start":466.714,"end":467.037},{"word":"rivais","start":467.138,"end":467.4}]},{"start":467.38,"end":469.04,"text":"Tipo apertarem as mãos","words":[{"word":"Tipo","start":467.38,"end":467.934},{"word":"apertarem","start":467.974,"end":468.487},{"word":"as","start":468.569,"end":468.733},{"word":"mãos","start":468.835,"end":469.04}]},{"start":469.02,"end":470.621,"text":"Era uma ameaça em comum","words":[{"word":"Era","start":469.02,"end":469.759},{"word":"uma","start":469.8,"end":469.882},{"word":"ameaça","start":469.923,"end":470.333},{"word":"em","start":470.354,"end":470.456},{"word":"comum","start":470.477,"end":470.621}]},{"start":470.6,"end":472.68,"text":"E Jesus era essa ameaça","words":[{"word":"E","start":470.6,"end":471.028},{"word":"Jesus","start":471.191,"end":471.742},{"word":"era","start":471.905,"end":472.069},{"word":"essa","start":472.13,"end":472.293},{"word":"ameaça","start":472.313,"end":472.68}]},{"start":472.66,"end":476.08,"text":"Eles representavam juntos o núcleo do Sinedro","words":[{"word":"Eles","start":472.66,"end":473.409},{"word":"representavam","start":473.47,"end":474.198},{"word":"juntos","start":474.34,"end":474.805},{"word":"o","start":474.947,"end":474.987},{"word":"núcleo","start":475.109,"end":475.514},{"word":"do","start":475.574,"end":475.655},{"word":"Sinedro","start":475.736,"end":476.08}]},{"start":476.06,"end":478.94,"text":"Só para aclarear esse termo para o pessoal que está ouvindo","words":[{"word":"Só","start":476.06,"end":476.547},{"word":"para","start":476.608,"end":476.729},{"word":"aclarear","start":476.81,"end":477.155},{"word":"esse","start":477.196,"end":477.419},{"word":"termo","start":477.561,"end":477.825},{"word":"para","start":478.048,"end":478.149},{"word":"o","start":478.17,"end":478.19},{"word":"pessoal","start":478.251,"end":478.555},{"word":"que","start":478.575,"end":478.677},{"word":"está","start":478.697,"end":478.778},{"word":"ouvindo","start":478.798,"end":478.94}]},{"start":478.92,"end":481.72,"text":"O Sinedro funcionava basicamente como","words":[{"word":"O","start":478.92,"end":479.732},{"word":"Sinedro","start":479.772,"end":480.32},{"word":"funcionava","start":480.401,"end":480.848},{"word":"basicamente","start":480.99,"end":481.578},{"word":"como","start":481.639,"end":481.72}]},{"start":481.7,"end":485.76,"text":"Como a Suprema Corte de Israel naquela época, não é?","words":[{"word":"Como","start":481.7,"end":481.922},{"word":"a","start":482.73,"end":483.074},{"word":"Suprema","start":483.538,"end":483.942},{"word":"Corte","start":484.104,"end":484.407},{"word":"de","start":484.467,"end":484.548},{"word":"Israel","start":484.568,"end":484.993},{"word":"naquela","start":485.033,"end":485.296},{"word":"época","start":485.397,"end":485.619},{"word":"não","start":485.639,"end":485.7},{"word":"é","start":485.72,"end":485.76}]},{"start":485.84,"end":487.481,"text":"O órgão máximo de poder.","words":[{"word":"O","start":485.84,"end":486.476},{"word":"órgão","start":486.496,"end":486.742},{"word":"máximo","start":486.845,"end":487.214},{"word":"de","start":487.234,"end":487.296},{"word":"poder","start":487.357,"end":487.481}]},{"start":487.7,"end":488.601,"text":"Exatamente isso.","words":[{"word":"Exatamente","start":487.7,"end":488.475},{"word":"isso","start":488.496,"end":488.601}]},{"start":488.72,"end":490.321,"text":"Era o Tribunal Supremo.","words":[{"word":"Era","start":488.72,"end":489.13},{"word":"o","start":489.171,"end":489.192},{"word":"Tribunal","start":489.315,"end":489.849},{"word":"Supremo","start":490.013,"end":490.321}]},{"start":490.54,"end":495.96,"text":"Então, quando espiões dessa Suprema Corte aparecem lá exigindo um sinal do céu,","words":[{"word":"Então","start":490.54,"end":491.406},{"word":"quando","start":491.568,"end":491.729},{"word":"espiões","start":491.789,"end":492.414},{"word":"dessa","start":492.474,"end":492.676},{"word":"Suprema","start":492.736,"end":493.079},{"word":"Corte","start":493.2,"end":493.623},{"word":"aparecem","start":493.663,"end":494.389},{"word":"lá","start":494.449,"end":494.55},{"word":"exigindo","start":494.61,"end":495.174},{"word":"um","start":495.235,"end":495.295},{"word":"sinal","start":495.376,"end":495.678},{"word":"do","start":495.718,"end":495.799},{"word":"céu","start":495.88,"end":495.96}]},{"start":496.44,"end":499.72,"text":"eles não estão, tipo, buscando motivos sinceros para crer.","words":[{"word":"eles","start":496.44,"end":496.906},{"word":"não","start":496.926,"end":497.027},{"word":"estão","start":497.047,"end":497.189},{"word":"tipo","start":497.351,"end":497.655},{"word":"buscando","start":497.857,"end":498.242},{"word":"motivos","start":498.303,"end":498.667},{"word":"sinceros","start":498.748,"end":499.356},{"word":"para","start":499.417,"end":499.538},{"word":"crer","start":499.619,"end":499.72}]},{"start":500.1,"end":502.66,"text":"Eles querem uma exibição cósmica, sabe?","words":[{"word":"Eles","start":500.1,"end":500.588},{"word":"querem","start":500.628,"end":500.852},{"word":"uma","start":500.913,"end":501.014},{"word":"exibição","start":501.075,"end":501.726},{"word":"cósmica","start":501.99,"end":502.538},{"word":"sabe","start":502.559,"end":502.66}]},{"start":502.68,"end":506.88,"text":"Um truque de mágica nos céus só para desmoralizar Jesus caso ele falhasse.","words":[{"word":"Um","start":502.68,"end":502.842},{"word":"truque","start":502.963,"end":503.205},{"word":"de","start":503.245,"end":503.326},{"word":"mágica","start":503.387,"end":503.791},{"word":"nos","start":503.851,"end":503.952},{"word":"céus","start":504.053,"end":504.396},{"word":"só","start":504.417,"end":504.76},{"word":"para","start":504.78,"end":504.861},{"word":"desmoralizar","start":504.901,"end":505.608},{"word":"Jesus","start":505.628,"end":506.052},{"word":"caso","start":506.113,"end":506.355},{"word":"ele","start":506.375,"end":506.476},{"word":"falhasse","start":506.537,"end":506.88}]},{"start":507.02,"end":508.121,"text":"Uma armadinha armada.","words":[{"word":"Uma","start":507.02,"end":507.269},{"word":"armadinha","start":507.311,"end":507.726},{"word":"armada","start":507.768,"end":508.121}]},{"start":508.3,"end":508.842,"text":"Com certeza.","words":[{"word":"Com","start":508.3,"end":508.603},{"word":"certeza","start":508.668,"end":508.842}]},{"start":508.86,"end":511.12,"text":"E a resposta de Jesus é genial.","words":[{"word":"E","start":508.86,"end":509.165},{"word":"a","start":509.186,"end":509.247},{"word":"resposta","start":509.552,"end":509.939},{"word":"de","start":509.98,"end":510.061},{"word":"Jesus","start":510.123,"end":510.509},{"word":"é","start":510.652,"end":510.733},{"word":"genial","start":510.978,"end":511.12}]},{"start":511.7,"end":525.76,"text":"Ele aponta para o céu físico e diz, em termos práticos, olhem para cima, o céu está avermelhado hoje, então vocês preveem que amanhã vai dar bom tempo.","words":[{"word":"Ele","start":511.7,"end":512.342},{"word":"aponta","start":512.422,"end":512.783},{"word":"para","start":512.843,"end":512.923},{"word":"o","start":512.944,"end":512.964},{"word":"céu","start":513.024,"end":513.164},{"word":"físico","start":513.264,"end":513.585},{"word":"e","start":513.605,"end":513.625},{"word":"diz","start":513.726,"end":514.067},{"word":"em","start":514.167,"end":514.528},{"word":"termos","start":514.628,"end":518.981},{"word":"práticos","start":519.061,"end":519.643},{"word":"olhem","start":520.244,"end":520.405},{"word":"para","start":520.445,"end":520.565},{"word":"cima","start":520.686,"end":520.966},{"word":"o","start":521.568,"end":521.608},{"word":"céu","start":521.709,"end":521.849},{"word":"está","start":521.909,"end":521.989},{"word":"avermelhado","start":522.009,"end":522.651},{"word":"hoje","start":522.691,"end":523.052},{"word":"então","start":523.413,"end":523.674},{"word":"vocês","start":523.754,"end":524.035},{"word":"preveem","start":524.095,"end":524.517},{"word":"que","start":524.557,"end":524.657},{"word":"amanhã","start":524.697,"end":525.018},{"word":"vai","start":525.058,"end":525.178},{"word":"dar","start":525.219,"end":525.319},{"word":"bom","start":525.379,"end":525.539},{"word":"tempo","start":525.62,"end":525.76}]},{"start":525.98,"end":533.26,"text":"Vocês sabem ler a meteorologia, mas são completamente cegos para ler os sinais espirituais que estão acontecendo bem na frente do nariz de vocês.","words":[{"word":"Vocês","start":525.98,"end":526.644},{"word":"sabem","start":526.744,"end":527.066},{"word":"ler","start":527.126,"end":527.247},{"word":"a","start":527.267,"end":527.287},{"word":"meteorologia","start":527.307,"end":528.072},{"word":"mas","start":528.192,"end":528.333},{"word":"são","start":528.393,"end":528.494},{"word":"completamente","start":528.554,"end":529.158},{"word":"cegos","start":529.379,"end":529.7},{"word":"para","start":529.741,"end":529.861},{"word":"ler","start":529.902,"end":530.002},{"word":"os","start":530.022,"end":530.062},{"word":"sinais","start":530.123,"end":530.404},{"word":"espirituais","start":530.424,"end":531.148},{"word":"que","start":531.189,"end":531.269},{"word":"estão","start":531.289,"end":531.41},{"word":"acontecendo","start":531.45,"end":531.893},{"word":"bem","start":532.053,"end":532.194},{"word":"na","start":532.214,"end":532.295},{"word":"frente","start":532.395,"end":532.617},{"word":"do","start":532.657,"end":532.717},{"word":"nariz","start":532.757,"end":532.979},{"word":"de","start":533.019,"end":533.059},{"word":"vocês","start":533.119,"end":533.26}]},{"start":533.54,"end":534.641,"text":"Nossa, um baita fora.","words":[{"word":"Nossa","start":533.54,"end":533.935},{"word":"um","start":533.955,"end":534.163},{"word":"baita","start":534.184,"end":534.516},{"word":"fora","start":534.537,"end":534.641}]},{"start":534.62,"end":538.44,"text":"Pois é, ele recusa o truque de mágica e se retira.","words":[{"word":"Pois","start":534.62,"end":535.287},{"word":"é","start":535.348,"end":535.469},{"word":"ele","start":536.055,"end":536.176},{"word":"recusa","start":536.237,"end":536.702},{"word":"o","start":536.742,"end":536.783},{"word":"truque","start":536.843,"end":537.025},{"word":"de","start":537.066,"end":537.126},{"word":"mágica","start":537.227,"end":537.672},{"word":"e","start":537.753,"end":537.793},{"word":"se","start":537.874,"end":537.935},{"word":"retira","start":537.996,"end":538.44}]},{"start":538.66,"end":543.56,"text":"A hostilidade ali fica tão insuportável que força essa mudança drástica de cenário.","words":[{"word":"A","start":538.66,"end":539.144},{"word":"hostilidade","start":539.184,"end":539.83},{"word":"ali","start":539.951,"end":540.152},{"word":"fica","start":540.172,"end":540.414},{"word":"tão","start":540.596,"end":540.737},{"word":"insuportável","start":540.798,"end":541.483},{"word":"que","start":541.523,"end":541.624},{"word":"força","start":541.725,"end":542.007},{"word":"essa","start":542.028,"end":542.169},{"word":"mudança","start":542.229,"end":542.592},{"word":"drástica","start":542.693,"end":543.096},{"word":"de","start":543.137,"end":543.197},{"word":"cenário","start":543.258,"end":543.56}]},{"start":543.66,"end":549.66,"text":"E é aí que a narrativa ganha aquele contorno geográfico absurdo que a gente mencionou no início do mergulho, né?","words":[{"word":"E","start":543.66,"end":544.445},{"word":"é","start":544.465,"end":544.566},{"word":"aí","start":544.586,"end":544.808},{"word":"que","start":544.828,"end":544.928},{"word":"a","start":544.949,"end":544.969},{"word":"narrativa","start":545.009,"end":545.472},{"word":"ganha","start":545.593,"end":545.794},{"word":"aquele","start":545.814,"end":546.056},{"word":"contorno","start":546.116,"end":546.559},{"word":"geográfico","start":546.62,"end":547.143},{"word":"absurdo","start":547.163,"end":547.566},{"word":"que","start":547.606,"end":547.667},{"word":"a","start":547.707,"end":547.727},{"word":"gente","start":547.747,"end":547.989},{"word":"mencionou","start":548.311,"end":548.734},{"word":"no","start":548.754,"end":548.814},{"word":"início","start":548.855,"end":549.116},{"word":"do","start":549.157,"end":549.197},{"word":"mergulho","start":549.257,"end":549.58},{"word":"né","start":549.6,"end":549.66}]},{"start":549.68,"end":551.76,"text":"Porque eles caminham dezenas de quilômetros para o norte,","words":[{"word":"Porque","start":549.68,"end":549.884},{"word":"eles","start":549.904,"end":550.027},{"word":"caminham","start":550.068,"end":550.373},{"word":"dezenas","start":550.435,"end":550.843},{"word":"de","start":550.883,"end":550.924},{"word":"quilômetros","start":550.965,"end":551.434},{"word":"para","start":551.495,"end":551.577},{"word":"o","start":551.597,"end":551.618},{"word":"norte","start":551.638,"end":551.76}]},{"start":552.44,"end":555.98,"text":"eles sobem as colinas até chegar à região de Cesareia de Filipe.","words":[{"word":"eles","start":552.44,"end":552.824},{"word":"sobem","start":552.865,"end":553.31},{"word":"as","start":553.35,"end":553.451},{"word":"colinas","start":553.532,"end":553.998},{"word":"até","start":554.038,"end":554.16},{"word":"chegar","start":554.24,"end":554.544},{"word":"à","start":554.584,"end":554.605},{"word":"região","start":554.645,"end":554.888},{"word":"de","start":554.928,"end":554.969},{"word":"Cesareia","start":555.07,"end":555.576},{"word":"de","start":555.596,"end":555.657},{"word":"Filipe","start":555.758,"end":555.98}]}]
